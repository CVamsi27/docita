{
  "$schema": "https://kuberns.com/schema.json",
  "services": {
    "api": {
      "root": ".",
      "install": "pnpm install --frozen-lockfile",
      "preBuild": "pnpm --filter @workspace/db run build && pnpm --filter @workspace/types run build",
      "build": "pnpm --filter @docita/api run build",
      "postBuild": "pnpm --filter @workspace/db run db:migrate:deploy",
      "start": "node apps/api/dist/main",
      "port": 3001,
      "healthcheck": "/api/health",
      "nodeVersion": "20"
    }
  }
}
