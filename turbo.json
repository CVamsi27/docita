{
  "$schema": "https://v2-8-12.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "ANALYZE",
    "DATABASE_URL",
    "JWT_SECRET",
    "ABDM_BASE_URL",
    "ABDM_CALLBACK_SECRET",
    "ABDM_CLIENT_ID",
    "ABDM_CLIENT_SECRET",
    "ABDM_ABHA_BASE_URL",
    "ABDM_ABHA_PUBLIC_KEY",
    "API_PROXY_TARGET",
    "API_URL",
    "APP_URL",
    "PUBLIC_API_URL",
    "PUBLIC_APP_URL",
    "PUBLIC_ANALYTICS_URL",
    "PUBLIC_ENABLE_LIVE_LANDING_DATA",
    "FRONTEND_URL",
    "API_PUBLIC_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "ENABLE_SCHEDULERS",
    "TURNSTILE_SECRET_KEY",
    "VITE_API_URL",
    "VITE_APP_URL",
    "VITE_MAIN_APP_URL",
    "VITE_SOCKET_URL",
    "VITE_AI_ENABLED",
    "VITE_GOOGLE_MAPS_API_KEY",
    "VITE_TURNSTILE_SITE_KEY",
    "VITE_RAZORPAY_KEY_ID",
    "VITE_SENTRY_DSN",
    "VITE_WHATSAPP_SUPPORT_NUMBER",
    "ZEPTOMAIL_WEBHOOK_SECRET",
    "GRIEVANCE_CONTACT_EMAIL",
    "CI",
    "DOCITA_CLOUDFLARE",
    "DOCITA_ENV",
    "PLAYWRIGHT_TEST_BASE_URL",
    "API_HEALTH_URL",
    "SKIP_SERVER",
    "RAZORPAY_KEY_SECRET",
    "PARTNER_PORTAL_URL",
    "DATABASE_CONTROL_ENABLED",
    "DATABASE_CONTROL_ALLOWED_ENV",
    "DATABASE_CONTROL_AWS_REGION",
    "DATABASE_CONTROL_RDS_INSTANCE_ID",
    "DATABASE_CONTROL_ALERT_EMAIL",
    "DATABASE_CONTROL_DEPLOY_GUARD",
    "DATABASE_CONTROL_COOLDOWN_SECONDS",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "check-types", "lint"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"],
      "env": [
        "NODE_ENV",
        "API_URL",
        "APP_URL",
        "PUBLIC_API_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_ANALYTICS_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "ENABLE_SCHEDULERS",
        "CI",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "DOCITA_CLOUDFLARE",
        "DOCITA_ENV",
        "PLAYWRIGHT_TEST_BASE_URL",
        "API_HEALTH_URL",
        "SKIP_SERVER"
      ]
    },
    "@docita/app#build": {
      "dependsOn": ["^build", "^check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "VITE_API_URL",
        "VITE_APP_URL",
        "VITE_SOCKET_URL",
        "VITE_SENTRY_DSN",
        "VITE_AI_ENABLED",
        "VITE_API_TARGET",
        "CI"
      ]
    },
    "@docita/app#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "@docita/internal#build": {
      "dependsOn": ["^build", "^check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "VITE_API_URL",
        "VITE_APP_URL",
        "VITE_MAIN_APP_URL",
        "VITE_SENTRY_DSN",
        "CI"
      ]
    },
    "@docita/internal#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "AUDIT_APP_PUBLIC_ONLY",
        "DATABASE_URL",
        "API_URL",
        "APP_URL",
        "PUBLIC_API_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_ANALYTICS_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "ENABLE_SCHEDULERS",
        "CI",
        "DOCITA_CLOUDFLARE",
        "DOCITA_ENV",
        "PLAYWRIGHT_TEST_BASE_URL",
        "API_HEALTH_URL",
        "SKIP_SERVER"
      ]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx"
      ],
      "env": [
        "AUDIT_APP_PUBLIC_ONLY",
        "DATABASE_URL",
        "API_URL",
        "APP_URL",
        "ENABLE_SCHEDULERS",
        "CI",
        "PLAYWRIGHT_TEST_BASE_URL",
        "API_HEALTH_URL",
        "SKIP_SERVER"
      ]
    },
    "@workspace/db#test": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "scripts/**/*.mjs"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
