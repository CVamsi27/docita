{
  "$schema": "https://v2-8-12.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "ANALYZE",
    "NEXT_RUNTIME",
    "DATABASE_URL",
    "JWT_SECRET",
    "API_PROXY_TARGET",
    "API_URL",
    "APP_URL",
    "PUBLIC_API_URL",
    "PUBLIC_APP_URL",
    "PUBLIC_ANALYTICS_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SOCKET_URL",
    "ENABLE_SCHEDULERS",
    "CI",
    "DOCITA_CLOUDFLARE",
    "DOCITA_ENV",
    "PLAYWRIGHT_TEST_BASE_URL",
    "API_HEALTH_URL",
    "SKIP_SERVER",
    "RUN_VISUAL_REGRESSION",
    "NEXT_PUBLIC_ENABLE_VISUAL_TESTS",
    "NEXT_PUBLIC_ENABLE_TOOLS",
    "RAZORPAY_KEY_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "check-types", "lint"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NODE_ENV",
        "API_URL",
        "APP_URL",
        "PUBLIC_API_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_ANALYTICS_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SOCKET_URL",
        "ENABLE_SCHEDULERS",
        "CI",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "DOCITA_CLOUDFLARE",
        "DOCITA_ENV",
        "PLAYWRIGHT_TEST_BASE_URL",
        "API_HEALTH_URL",
        "SKIP_SERVER"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "AUDIT_APP_PUBLIC_ONLY",
        "DATABASE_URL",
        "API_URL",
        "APP_URL",
        "PUBLIC_API_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_ANALYTICS_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SOCKET_URL",
        "ENABLE_SCHEDULERS",
        "CI",
        "DOCITA_CLOUDFLARE",
        "DOCITA_ENV",
        "PLAYWRIGHT_TEST_BASE_URL",
        "API_HEALTH_URL",
        "SKIP_SERVER"
      ]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx"
      ],
      "env": [
        "AUDIT_APP_PUBLIC_ONLY",
        "DATABASE_URL",
        "API_URL",
        "APP_URL",
        "ENABLE_SCHEDULERS",
        "CI",
        "PLAYWRIGHT_TEST_BASE_URL",
        "API_HEALTH_URL",
        "SKIP_SERVER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
