# Database
DATABASE_URL="postgresql://user:password@localhost:5432/docita?sslmode=require"

# Security
JWT_SECRET="replace-with-minimum-32-char-secret"
ENCRYPTION_KEY="replace-with-64-char-hex-key"

# App
NODE_ENV="development"
PORT="3001"
LOG_LEVEL="debug"
APP_URL="http://localhost:3000"
APP_VERSION="1.0.0"

# URLs & CORS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# Payments (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Messaging (Meta/WhatsApp)
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
WHATSAPP_PRODUCTION_MODE="false"

# AI & External APIs
OPENAI_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_API_URL="https://api.resend.com/emails"
EMAIL_FROM="Docita <noreply@docita.work>"

# Infrastructure (Redis & Caching)
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_USERNAME=""
QUEUE_PROVIDER="memory"
CACHE_PROVIDER="memory"
ANALYTICS_CACHE_TTL="300"

# Monitoring (Sentry)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"

# Business Logic & Timeouts
PAYMENT_LINK_TTL_MINUTES="15"
BULK_IMPORT_MAX_FILE_SIZE="52428800"
BULK_IMPORT_MAX_ROWS="100000"
BULK_IMPORT_RATE_LIMIT_INTERVAL="300"
SLOW_QUERY_THRESHOLD_MS="1000"
REQUEST_TIMEOUT_MS="30000"
