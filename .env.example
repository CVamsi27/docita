# Core API runtime
# Use docita_app (non-owner) in staging/production when RLS_ENABLED=true; see docs/compliance/RLS_ROLLOUT.md
DATABASE_URL=postgresql://docita:docita@localhost:5434/docita?options=-c%20TimeZone%3DUTC
# Local dev default; production sets RLS_ENABLED=true in fly.toml
RLS_ENABLED=false
JWT_SECRET=replace-with-minimum-32-char-secret
ENCRYPTION_KEY=replace-with-64-char-hex-key
ENCRYPTION_KEY_V2=
ENCRYPTION_KEY_V3=
ENCRYPTION_KEY_V4=
ENCRYPTION_KEY_V5=
NODE_ENV=development
PORT=3001
CPU_COUNT=4
LOG_LEVEL=info
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser (Next.js app/internal): same-origin proxy so httpOnly auth cookies work locally.
NEXT_PUBLIC_API_URL=/api/v1
# Server-side upstream for apps/app/app/api/v1/[...path] proxy (not used by the browser).
API_URL=http://127.0.0.1:3001/api/v1
API_PROXY_TARGET=http://127.0.0.1:3001
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
JWT_EXPIRATION=30d
APP_VERSION=1.0.0
API_LOG_MODE=access-and-errors
SECRETS_PROVIDER=env

# Queues and cache
# Background work and caching run in-process with memory-backed services.
ANALYTICS_CACHE_TTL=300

# Billing and business limits
PAYMENT_LINK_TTL_MINUTES=15
BULK_IMPORT_MAX_FILE_SIZE=52428800
BULK_IMPORT_MAX_ROWS=100000
BULK_IMPORT_RATE_LIMIT_INTERVAL=300
SLOW_QUERY_THRESHOLD_MS=1000
REQUEST_TIMEOUT_MS=30000

# Payments (Razorpay) — required for API in staging/production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Messaging (Meta / WhatsApp)
WHATSAPP_PRODUCTION_MODE=false
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_BUSINESS_ACCOUNT_ID=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
AI_REQUEST_TIMEOUT=5000
AI_CACHE_ENABLED=true
AI_CACHE_TTL=86400

# Email, SMS, verification integrations
ZEPTOMAIL_SENDMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# Shared secret used to verify the ZeptoMail delivery webhook (HMAC-SHA256 of the raw body).
ZEPTOMAIL_WEBHOOK_SECRET=
EMAIL_FROM=Docita <notifications@docita.work>
SMS_API_KEY=
SMS_SENDER_ID=
# Optional external doctor-license verification provider
DOCTOR_VERIFICATION_API_URL=
DOCTOR_VERIFICATION_API_KEY=

# Clinical coding provider
CPT_CATALOG_SOURCE=nlm_hcpcs
CPT_LICENSED_API_URL=
CPT_LICENSED_API_KEY=
CPT_LICENSED_SEARCH_PATH=/search
CPT_LICENSED_SYNC_PATH=/codes

# Document storage (Cloudflare R2)
# For production set STORAGE_PROVIDER=r2 and configure all R2_* values.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=docita-storage
# Note: Next.js ISR cache bucket uses Wrangler binding
# NEXT_INC_CACHE_R2_BUCKET -> docita-cache (no .env var needed)

# Monitoring and source-map upload
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_PROFILING=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_PROJECT=javascript-nextjs
SENTRY_ORG=docita
SENTRY_PROJECT=admin
SENTRY_AUTH_TOKEN=

# Frontend runtime (apps/app, apps/internal, apps/landing)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ENABLE_CONSOLE_TOASTS=false
NEXT_PUBLIC_CAPTURE_CONSOLE_INFO=false
NEXT_PUBLIC_CAPTURE_CONSOLE_WARNINGS=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# WhatsApp support contact in international format (digits only), e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
NEXT_PUBLIC_CLINIC_NAME=

# Build-time tooling toggles
API_PROXY_TARGET=http://localhost:3001
DOCITA_CLOUDFLARE=0
ANALYZE=false

# Optional script/e2e overrides
API_URL=http://localhost:3001/api/v1
DOCITA_API_BASE=http://localhost:3001

# Background job queue backend ("memory" or "postgres")
QUEUE_BACKEND=memory
# Worker process entrypoint ("main" or "worker")
WORKER_ENTRYPOINT=main
