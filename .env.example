# Database (required)
DATABASE_URL="postgresql://docita:docita@localhost:5434/docita"

# Security (required)
JWT_SECRET="replace-with-minimum-32-char-secret"
ENCRYPTION_KEY="replace-with-64-char-hex-key"

# Historical encryption keys (optional - for key rotation)
# ENCRYPTION_KEY_V2=""
# ENCRYPTION_KEY_V3=""
# ENCRYPTION_KEY_V4=""
# ENCRYPTION_KEY_V5=""

# App
NODE_ENV="development"
PORT="3001"
LOG_LEVEL="debug"
APP_URL="http://localhost:3000"
APP_VERSION="1.0.0"
API_LOG_MODE="access-and-errors"
JWT_EXPIRATION="7d"
SECRETS_PROVIDER="env"

# URLs & CORS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# Payments (Razorpay) - optional
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Messaging (Meta/WhatsApp) - optional
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_BUSINESS_ACCOUNT_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
WHATSAPP_PRODUCTION_MODE="false"

# AI (optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo"
AI_REQUEST_TIMEOUT="5000"
AI_CACHE_ENABLED="true"
AI_CACHE_TTL="86400"

# Email - Resend (optional)
RESEND_API_KEY=""
RESEND_API_URL="https://api.resend.com/emails"
EMAIL_FROM="Docita <notifications@docita.work>"

# Email - SMTP (optional, alternative to Resend)
# SMTP_HOST="localhost"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# SMS (optional)
# SMS_API_KEY=""
# SMS_SENDER_ID=""

# Doctor Verification (optional)
# DOCTOR_VERIFICATION_API_URL=""
# DOCTOR_VERIFICATION_API_KEY=""

# Infrastructure - Redis & Caching
# Redis is optional. Default is in-memory (no Redis required for local dev).
# REDIS_URL=""
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""
# REDIS_USERNAME=""
QUEUE_PROVIDER="memory"
CACHE_PROVIDER="memory"
ANALYTICS_CACHE_TTL="300"

# Storage (Cloudflare R2) - optional, defaults to local filesystem
# Set STORAGE_PROVIDER=r2 to enable R2. PDFs are generated once, stored immutably, served via signed URLs.
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="docita"

# Monitoring (Sentry) - optional
SENTRY_ORG="docita"
SENTRY_AUTH_TOKEN=""
# API backend (Railway) - used by instrument.ts + source map uploads
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
SENTRY_PROJECT="node-nestjs"
# Frontend (Next.js) - NEXT_PUBLIC_ prefix required for browser access
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_PROJECT="javascript-nextjs"

# Business Logic & Timeouts
PAYMENT_LINK_TTL_MINUTES="15"
BULK_IMPORT_MAX_FILE_SIZE="52428800"
BULK_IMPORT_MAX_ROWS="100000"
BULK_IMPORT_RATE_LIMIT_INTERVAL="300"
SLOW_QUERY_THRESHOLD_MS="1000"
REQUEST_TIMEOUT_MS="30000"
