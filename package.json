{
  "name": "docita",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "start": "pnpm --filter @docita/api run start:prod",
    "patch:opennext-prefetch-manifest": "node scripts/ensure-opennext-prefetch-manifest-patch.mjs",
    "dev": "pnpm dev:full",
    "dev:full": "node scripts/kill-ports.js && node scripts/db-check.mjs && turbo dev --concurrency=20 --filter=@docita/landing --filter=@docita/app --filter=@docita/admin --filter=@docita/api",
    "dev:landing": "turbo dev --concurrency=20 --filter=@docita/landing",
    "dev:app": "node scripts/db-check.mjs && turbo dev --concurrency=20 --filter=@docita/app --filter=@docita/api",
    "dev:admin": "node scripts/db-check.mjs && turbo dev --concurrency=20 --filter=@docita/admin --filter=@docita/api",
    "build:landing": "turbo build --filter=@docita/landing",
    "build:landing:cloudflare": "pnpm --filter @docita/landing run build:cloudflare",
    "preview:landing:cloudflare": "pnpm --filter @docita/landing run preview:cloudflare",
    "deploy:landing:cloudflare": "pnpm --filter @docita/landing run deploy:cloudflare",
    "build:app": "turbo build --filter=@docita/app",
    "build:app:cloudflare": "pnpm --filter @docita/app run build:cloudflare",
    "preview:app:cloudflare": "pnpm --filter @docita/app run preview:cloudflare",
    "deploy:app:cloudflare": "pnpm --filter @docita/app run deploy:cloudflare",
    "build:admin": "turbo build --filter=@docita/admin",
    "build:admin:cloudflare": "pnpm --filter @docita/admin run build:cloudflare",
    "preview:admin:cloudflare": "pnpm --filter @docita/admin run preview:cloudflare",
    "deploy:admin:cloudflare": "pnpm --filter @docita/admin run deploy:cloudflare",
    "build:api": "turbo build --filter=@docita/api",
    "test": "turbo test",
    "test:unit:local": "pnpm --filter @workspace/utils run test && pnpm --filter @workspace/ui run test && pnpm --filter @docita/admin run test && pnpm --filter @docita/app run test && pnpm --filter @docita/api run test",
    "test:api": "turbo test --filter=@docita/api",
    "test:e2e": "turbo test --filter=@docita/app",
    "test:landing": "pnpm --filter @docita/landing run test:critical-flows",
    "test:landing:a11y": "pnpm --filter @docita/landing run audit:accessibility",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "audit:accessibility": "tsx scripts/accessibility-audit.ts",
    "audit:app": "pnpm --filter @docita/app run audit:accessibility",
    "audit:admin": "pnpm --filter @docita/admin run audit:accessibility",
    "audit:landing": "pnpm --filter @docita/landing run audit:accessibility",
    "postinstall": "pnpm --filter @workspace/db run db:generate",
    "db:generate": "pnpm --filter @workspace/db run db:generate",
    "db:migrate": "pnpm --filter @workspace/db run db:migrate",
    "db:deploy": "pnpm --filter @workspace/db run db:migrate:deploy",
    "db:seed:local": "pnpm --filter @docita/api run seed:local",
    "db:diff": "pnpm --filter @workspace/db run db:diff",
    "db:profile": "pnpm --filter @workspace/db run db:profile-queries",
    "db:validate-feedback-backfill": "pnpm --filter @workspace/db run db:validate-feedback-backfill",
    "db:backfill-onboarding-clinic-state": "pnpm --filter @workspace/db run db:backfill-onboarding-clinic-state",
    "db:guardrail": "pnpm --filter @workspace/db run db:guardrail",
    "db:check": "node scripts/db-check.mjs",
    "db:up": "node scripts/db-check.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "verify:structure": "node scripts/verify-turborepo-structure.mjs",
    "verify:contracts": "node scripts/verify-package-contracts.mjs",
    "verify:standard": "pnpm check:hygiene && pnpm verify:structure && pnpm verify:contracts && pnpm check:prisma-boundary && pnpm check:sensitive-logging && pnpm check:no-console-runtime && pnpm check:auth-tenant-safety",
    "check:prisma-boundary": "node scripts/check-prisma-boundary.js",
    "check:auth-tenant-safety": "node scripts/check-auth-tenant-safety.mjs",
    "check:no-console-runtime": "node scripts/check-no-console-runtime.mjs",
    "check:colors": "node scripts/detect-hardcoded-colors.js",
    "check:sensitive-logging": "node scripts/check-sensitive-logging.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:landing:headers": "node scripts/verify-landing-headers.mjs",
    "perf:budget:warn": "PERF_BUDGET_MODE=warn node scripts/check-perf-budget.mjs",
    "perf:budget:enforce": "PERF_BUDGET_MODE=fail node scripts/check-perf-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "axe-core": "^4.11.1",
    "baseline-browser-mapping": "^2.9.19",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "prisma": "^7.6.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.9.0",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.12",
      "@rollup/plugin-commonjs>picomatch": "4.0.4",
      "@angular-devkit/core>ajv": "8.18.0",
      "schema-utils>ajv": "^8.18.0",
      "@eslint/eslintrc>ajv": "6.12.6",
      "eslint>ajv": "6.12.6",
      "anymatch>picomatch": "2.3.2",
      "ajv": "^8.18.0",
      "axios": "^1.14.0",
      "effect": "^3.21.0",
      "flatted": "^3.4.2",
      "file-type": "21.3.2",
      "fast-xml-parser": "^5.5.6",
      "basic-ftp": "^5.2.0",
      "defu": "^6.1.5",
      "diff": "^4.0.4",
      "handlebars": "^4.7.9",
      "hono": "^4.12.9",
      "jws": "3.2.3",
      "lodash": "^4.18.1",
      "multer": "^2.1.1",
      "path-to-regexp": "^8.4.2",
      "picomatch": "^4.0.4",
      "qs": "^6.15.0",
      "rollup": "^4.60.1",
      "serialize-javascript": "^7.0.5",
      "socket.io-parser": "^4.2.6",
      "tmp": "^0.2.4",
      "external-editor>tmp": "0.2.4",
      "undici": "^7.24.0",
      "yaml": "^2.8.3",
      "vite>yaml": "2.8.3",
      "ts-node>diff": "4.0.4",
      "webpack": "^5.104.1"
    },
    "ignoredBuiltDependencies": []
  }
}
