{
  "name": "docita",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "start": "pnpm --filter @docita/api run start:prod",
    "dev": "turbo dev --filter=@docita/landing --filter=@docita/app --filter=@docita/admin --filter=@docita/api",
    "dev:landing": "turbo dev --filter=@docita/landing",
    "dev:app": "turbo dev --filter=@docita/app --filter=@docita/api",
    "dev:admin": "turbo dev --filter=@docita/admin --filter=@docita/api",
    "build:landing": "turbo build --filter=@docita/landing",
    "build:app": "turbo build --filter=@docita/app",
    "build:admin": "turbo build --filter=@docita/admin",
    "build:api": "turbo build --filter=@docita/api",
    "test": "turbo test",
    "test:api": "turbo test --filter=@docita/api",
    "test:e2e": "turbo test --filter=@docita/app",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "audit:accessibility": "tsx scripts/accessibility-audit.ts",
    "audit:app": "pnpm --filter @docita/app run audit:accessibility",
    "audit:admin": "pnpm --filter @docita/admin run audit:accessibility",
    "audit:landing": "pnpm --filter @docita/landing run audit:accessibility",
    "postinstall": "pnpm --filter @workspace/db run db:generate",
    "db:generate": "pnpm --filter @workspace/db run db:generate",
    "db:push": "pnpm --filter @workspace/db run db:push",
    "db:migrate": "pnpm --filter @workspace/db run db:migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "axe-core": "^4.11.1",
    "baseline-browser-mapping": "^2.9.19",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "ignoredBuiltDependencies": []
  }
}
