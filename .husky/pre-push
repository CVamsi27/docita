# Pre-push smoke check. Runs the cheap subset of verify:standard gates
# that catch the regression classes we've already hit (jscpd clones,
# missing i18n namespaces, broken gate wiring, raw buttons, error-boundary
# coverage, zod parity) without paying the ~6min cost of the full suite.
# CI runs the full suite — this hook exists to fail fast locally so a bad
# commit doesn't get pushed and waste a CI run.
#
# The full `pnpm verify:standard` is still the project merge gate.
# To bypass locally (e.g. for a hotfix), use `git push --no-verify`.
#
# Runtime budget: the checks below are grep-based and add ~1-2 s combined
# on a warm cache.
pnpm lint \
  && pnpm check:duplication \
  && pnpm check:standard-gate-wiring \
  && pnpm check:button-primitive --enforce \
  && pnpm check:i18n-coverage --enforce \
  && pnpm check:i18next-parity --enforce \
  && pnpm check:error-boundary-coverage --enforce \
  && pnpm check:zod-interface-parity --enforce \
  && pnpm test:standards-checks
