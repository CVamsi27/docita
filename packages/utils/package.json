{
  "name": "@workspace/utils",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http/upstream-api-proxy": {
      "types": "./dist/http/upstream-api-proxy.d.ts",
      "import": "./dist/http/upstream-api-proxy.js",
      "require": "./dist/http/upstream-api-proxy.cjs"
    },
    "./runtime/esbuild-helper-bootstrap": {
      "types": "./dist/runtime/esbuild-helper-bootstrap.d.ts",
      "import": "./dist/runtime/esbuild-helper-bootstrap.js",
      "require": "./dist/runtime/esbuild-helper-bootstrap.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/http/upstream-api-proxy.ts src/runtime/esbuild-helper-bootstrap.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "tsup": "^8.0.1",
    "typescript": "5.7.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@workspace/types": "workspace:^",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "tailwind-merge": "^2.3.0"
  }
}
