{
  "name": "@workspace/db",
  "version": "0.0.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:safe": "bash scripts/safe-migrate.sh deploy",
    "db:migrate:dry-run": "bash scripts/safe-migrate.sh dry-run",
    "db:migrate:generate": "bash scripts/safe-migrate.sh generate",
    "db:check-integrity": "pnpm exec ts-node scripts/check-integrity.ts",
    "db:check-tenant-isolation": "node scripts/check-tenant-isolation.mjs",
    "db:backup": "bash scripts/safe-migrate.sh backup",
    "db:studio": "prisma studio",
    "db:analyze-indexes": "pnpm exec ts-node scripts/analyze-indexes.ts",
    "db:profile-queries": "pnpm exec ts-node scripts/profile-queries.ts",
    "db:check-query-plans": "pnpm exec ts-node scripts/check-query-plans.ts",
    "db:validate-feedback-backfill": "pnpm exec ts-node scripts/validate-feedback-feature-backfill.ts",
    "db:prod-data-safety": "pnpm exec ts-node scripts/verify-production-data-safety.ts",
    "db:backfill-onboarding-clinic-state": "pnpm exec ts-node scripts/backfill-onboarding-clinic-state.ts",
    "db:backfill-subscription-quotas": "pnpm exec ts-node scripts/backfill-subscription-quotas.ts",
    "db:repair-appointments": "node ../../scripts/db/repair-appointment-instants.mjs",
    "db:repair-appointments:apply": "node ../../scripts/db/repair-appointment-instants.mjs --apply",
    "db:guardrail": "pnpm db:check-integrity && pnpm db:validate-feedback-backfill && pnpm db:analyze-indexes && pnpm db:profile-queries && pnpm db:check-query-plans",
    "test": "node --test scripts/*.test.ts"
  },
  "devDependencies": {
    "@prisma/config": "^7.6.0",
    "@types/node": "^22.14.1",
    "dotenv": "^16.6.1",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "@types/pg": "^8.11.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.11.3"
  }
}
