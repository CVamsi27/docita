{
  "name": "@workspace/db",
  "version": "0.0.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:safe": "bash scripts/safe-migrate.sh deploy",
    "db:migrate:dry-run": "bash scripts/safe-migrate.sh dry-run",
    "db:migrate:generate": "bash scripts/safe-migrate.sh generate",
    "db:check-integrity": "npx ts-node scripts/check-integrity.ts",
    "db:backup": "bash scripts/safe-migrate.sh backup",
    "db:studio": "prisma studio",
    "seed:cpt": "npx ts-node prisma/seed-cpt.ts",
    "seed:icd": "npx ts-node prisma/seed-icd.ts",
    "db:analyze-indexes": "npx ts-node scripts/analyze-indexes.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.11.3"
  }
}
