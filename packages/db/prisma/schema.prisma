  fileUrl       String?
  /// @json:importJobColumnMappingSchema
  columnMapping Json?
  totalRecords  Int             @default(0)
  processed     Int             @default(0)
  successful    Int             @default(0)
  failed        Int             @default(0)
  /// @json:importJobErrorsJsonSchema
  errors        Json?
  /// @json:importJobResultsJsonSchema
  results       Json?
