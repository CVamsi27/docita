model Invoice {
  id                       String           @id @default(cuid())
  appointmentId            String?          @unique
  patientId                String
  clinicId                 String?
  invoiceNumber            String?
  invoiceType              String           @default("BILL_OF_SUPPLY")
  currency                 String           @default("INR")
  // MONEY REPRESENTATION (schema-locked, additive-only):
  // The `*Cents` integer columns below are the canonical money representation
  // and MUST be read by new code. The legacy `Float` columns (total, subtotal,
  // discountTotal, taxTotal, grandTotal) are retained for backward compatibility
  // and are written as a derived mirror of the cents values
  // (see invoice-normalization.ts toInvoiceCentCreateFields). Do not add new
  // Float money columns; do not treat Float as the source of truth.
  total                    Float
  subtotal                 Float            @default(0)
  discountTotal            Float            @default(0)
  taxTotal                 Float            @default(0)
  grandTotal               Float            @default(0)
  // Canonical money columns — integer paise/cents. Prefer these everywhere.
  totalCents               Int              @default(0)
  subtotalCents            Int              @default(0)
  discountTotalCents       Int              @default(0)
  taxTotalCents            Int              @default(0)
  grandTotalCents          Int              @default(0)
  amountPaidCents          Int              @default(0)
  /// @json:invoiceTaxSummarySchema
  taxSummary               Json?
  /// @json:taxRegistrationSnapshotSchema
  sellerTaxSnapshot        Json?
  /// @json:taxRegistrationSnapshotSchema
  buyerTaxSnapshot         Json?
  placeOfSupplyStateCode   String?
  placeOfSupplyStateName   String?
  reverseCharge            Boolean          @default(false)
  issuedAt                 DateTime?        @db.Timestamptz(3)
  dueDate                  DateTime?        @db.Timestamptz(3)
  eInvoiceRequired         Boolean          @default(false)
  eInvoiceIrn              String?
  eInvoiceQrCode           String?
  eInvoiceAcknowledgedAt   DateTime?        @db.Timestamptz(3)
  status                   InvoiceStatus    @default(PENDING)
  /// @json:invoiceItemsSchema
  items                    Json
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(3)
  version                  Int              @default(1)
  approvalStatus           ApprovalStatus   @default(PENDING)
  approvedById             String?
  approvedAt               DateTime?        @db.Timestamptz(3)
  whatsappSentAt           DateTime?        @db.Timestamptz(3)
  whatsappMessageId        String?
  whatsappStatus           String?
  doctorName               String?
  doctorEmail              String?
  doctorPhone              String?
  doctorSpecialization     Specialization?
  doctorRole               HospitalRole?
  doctorRegistrationNumber String?
  doctorLicenseNumber      String?
  pdfUrl                   String?
  pdfGeneratedAt           DateTime?        @db.Timestamptz(3)
  pdfTemplateVersion       Int              @default(1)
  // Optional idempotency key for create paths. Unique-when-present so
  // duplicate POSTs from a retrying client surface as a P2002 the service
  // layer can convert into a 200 with the existing invoice.
  idempotencyKey           String?          @unique
  appointment              Appointment?     @relation(fields: [appointmentId], references: [id])
  clinic                   Clinic?          @relation(fields: [clinicId], references: [id])
  patient                  Patient          @relation(fields: [patientId], references: [id])
  paymentSessions          PaymentSession[]
  paymentRetries           PaymentRetry[]
  lineItems                InvoiceItem[]
  insuranceClaims          InsuranceClaim[]

  @@unique([clinicId, invoiceNumber])
  @@index([createdAt])
  @@index([clinicId])
  @@index([clinicId, issuedAt])
  @@index([clinicId, status, createdAt(sort: Desc)], map: "Invoice_clinicId_status_createdAt_desc_idx")
  @@index([patientId])
  @@index([status, createdAt])
  @@index([status])
}

