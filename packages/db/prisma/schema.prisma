  extractedData         Json?
  confidence            Float?
  /// @json:ocrFieldConfidenceScoresJsonSchema
  fieldConfidenceScores Json?
  /// @json:ocrSuggestedCorrectionsJsonSchema
  suggestedCorrections  Json?
  status                OcrDocumentStatus @default(PENDING)
  reviewedBy            String?
  reviewedAt            DateTime?
  /// @json:ocrCorrectionsJsonSchema
  corrections           Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
