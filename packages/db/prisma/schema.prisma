// ============================================================================
// LOINC Codes - Laboratory & Clinical Observation Standards
// ============================================================================

model LoincCode {
  id         String    @id @default(cuid())
  code       String    @unique // LOINC code (e.g., "2345-7")
  longName   String // Full descriptive name
  shortName  String? // Abbreviated name
  component  String? // What is being measured
  property   String? // Type of property (e.g., "Mass concentration")
  timeAspect String? // Point in time vs. over time
  system     String? // System/specimen type
  scale      String? // Quantitative, Ordinal, Nominal
  method     String? // Method of measurement
  classType  String? // Class/category
  status     String?   @default("ACTIVE") // Active, Deprecated, etc.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  labTests   LabTest[]

  @@index([code])
  @@index([component])
  @@index([classType])
}

// ============================================================================
// Immunization/Vaccination Records
// ============================================================================

model Immunization {
  id        String @id @default(cuid())
  patientId String

  // Vaccine identification
  vaccineName String // Common name (e.g., "COVID-19 Vaccine")
  cvxCode     String? // CDC CVX code
  mvxCode     String? // Manufacturer MVX code
  ndcCode     String? // National Drug Code

  // Vaccine details
  manufacturer   String?
  lotNumber      String?
  expirationDate DateTime?

  // Administration details
  administeredDate DateTime
  administeredBy   String? // Provider who administered
  administeredAt   String? // Location/facility
  site             ImmunizationSite?
  route            ImmunizationRoute?
  doseNumber       Int? // e.g., 1st dose, 2nd dose
  seriesComplete   Boolean? // Is series complete?

  // Documentation
  informationSource String? // e.g., "Historical", "Administered"
  notes             String?
  documentUrl       String? // Link to immunization record

  // Reactions (if any)
  hadReaction     Boolean @default(false)
  reactionDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([cvxCode])
  @@index([administeredDate])
}

// ============================================================================
// Consent Management - Legal & Compliance Tracking
// ============================================================================

model Consent {
  id        String @id @default(cuid())
  patientId String
  clinicId  String

  // Consent details
  consentType ConsentType
  status      ConsentStatus @default(PENDING)

  // Who gave consent
  givenBy         String? // Name of person giving consent
  givenByRelation String? // If not patient (e.g., "Parent", "Guardian")
  givenAt         DateTime?

  // Witness information
  witnessedBy String? // Name of witness
  witnessedAt DateTime?

  // Validity period
  validFrom  DateTime?
  validUntil DateTime?

  // Revocation tracking
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?

  // Associated procedure (for procedure-specific consent)
  procedureId   String? // Link to Procedure if applicable
  procedureName String? // Description of procedure

  // Documentation
  documentUrl     String? // Signed consent form
  templateVersion String? // Version of consent template used
  notes           String?

  // Digital Consent Audit (DPDP Compliance)
  ipAddress String?
  userAgent String?

  // Audit trail
  createdBy String? // Staff who created record
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([clinicId])
  @@index([consentType])
  @@index([status])
  @@index([validUntil])
}

// ============================================================================
// MRN Sequence Tracking (for clinic-prefixed sequential MRN generation)
// ============================================================================

model MrnSequence {
  id         String   @id @default(cuid())
  clinicId   String   @unique
  prefix     String // e.g., "DOC", "CLI"
  lastNumber Int      @default(0) // Last used sequence number
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

// ============================================================================
// Feedback System
// ============================================================================

model Feedback {
  id       String @id @default(cuid())
  clinicId String
  userId   String

  // Rating (1-5 stars)
  overallRating Int @default(3)

  // Feature feedback
  goodFeatures       String[] // List of features user likes
  goodFeaturesReason String? // Why they like these features

  badFeatures       String[] // List of features user dislikes
  badFeaturesReason String? // Why they dislike these features

  improvementAreas  String[] // Features that need improvement
  improvementReason String? // How to improve them

  featureRequests String? // New feature requests

  // Additional feedback
  generalComments String? // Any other comments

  // Metadata
  category   FeedbackCategory @default(GENERAL)
  status     FeedbackStatus   @default(NEW)
  adminNotes String? // Notes from admin reviewing feedback

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

enum FeedbackCategory {
  GENERAL
  UI_UX
  PERFORMANCE
  FEATURES
  BILLING
  SUPPORT
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

// ============================================================================
// Production Analytics & Monitoring
// ============================================================================

model ApiRequest {
  id           String   @id @default(cuid())
  clinicId     String?
  userId       String?
  method       String
  path         String
  statusCode   Int
  duration     Int // in milliseconds
  requestSize  Int? // in bytes
  responseSize Int? // in bytes
  userAgent    String?
  ip           String?
  error        String?
  errorStack   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([clinicId])
  @@index([userId])
  @@index([path])
  @@index([statusCode])
  @@index([createdAt])
  @@index([duration])
  @@index([clinicId, createdAt])
  @@index([path, method])
}

model ErrorLog {
  id          String        @id @default(cuid())
  clinicId    String?
  userId      String?
  type        String // HttpException, PrismaError, UnhandledError, etc.
  message     String
  stack       String?
  path        String?
  method      String?
  statusCode  Int?
  userAgent   String?
  ip          String?
  requestBody Json?
  metadata    Json?
  severity    ErrorSeverity @default(ERROR)
  resolved    Boolean       @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([clinicId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@index([clinicId, createdAt])
  @@index([type, severity])
}

model SystemMetric {
  id         String     @id @default(cuid())
  metricType MetricType
  value      Float
  unit       String?
  metadata   Json?
  recordedAt DateTime   @default(now())

  @@index([metricType])
  @@index([recordedAt])
  @@index([metricType, recordedAt])
}

model PerformanceAggregate {
  id            String   @id @default(cuid())
  path          String
  method        String
  period        String // hourly, daily
  periodStart   DateTime
  totalRequests Int
  successCount  Int
  errorCount    Int
  avgDuration   Float
  minDuration   Int
  maxDuration   Int
  p50Duration   Int?
  p95Duration   Int?
  p99Duration   Int?
  createdAt     DateTime @default(now())

  @@unique([path, method, period, periodStart])
  @@index([period])
  @@index([periodStart])
  @@index([path])
}

enum ErrorSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum MetricType {
  CPU_USAGE
  MEMORY_USAGE
  HEAP_USED
  HEAP_TOTAL
  ACTIVE_CONNECTIONS
  DB_QUERY_TIME
  UPTIME
  REQUEST_COUNT
  ERROR_RATE
  AVG_RESPONSE_TIME
}

// ============================================================================
// Usage-Based Pricing & Add-ons System
// ============================================================================

// Tier pricing configuration (base prices and included quotas)
model TierPricing {
  id   String     @id @default(cuid())
  tier ClinicTier @unique

  // Base pricing (in paise/cents)
  monthlyBasePriceCents Int
  currency              String @default("INR")

  // Included quotas (usage within these limits is free)
  includedPatients     Int // Active patients per month
  includedAppointments Int // Appointments per month
  includedStorageGB    Int // Storage in GB
  includedUsers        Int // Number of users (doctors/staff)

  // Overage rates (in paise per unit)
  overagePatientCents     Int // Per additional active patient
  overageAppointmentCents Int // Per additional appointment
  overageStorageCents     Int // Per additional GB
  overageUserCents        Int // Per additional user

  // Tier features (JSON array of feature keys)
  features Json @default("[]")

  // Display info
  name         String
  description  String
  tagline      String?
  color        String  @default("blue")
  displayOrder Int     @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Add-on products (WhatsApp, Intelligence, etc.)
model AddOn {
  id   String    @id @default(cuid())
  type AddOnType @unique

  // Base pricing per tier (in paise)
  pricingByTier Json // { "CORE": 49900, "PLUS": 79900, "PRO": 149900 }

  // Included quotas per tier
  includedQuotaByTier Json // { "CORE": 500, "PLUS": 1500, "PRO": 5000 }

  // Overage rates per tier (in paise per unit)
  overageRateByTier Json // { "CORE": 50, "PLUS": 40, "PRO": 30 }

  // Display info
  name        String
  description String
  icon        String?
  features    Json    @default("[]") // Array of feature strings

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clinicAddOns ClinicAddOn[]

  @@index([isActive])
}

// Clinic's active add-ons
model ClinicAddOn {
  id        String    @id @default(cuid())
  clinicId  String
  addOnId   String
  addOnType AddOnType

  // Status
  status AddOnStatus @default(ACTIVE)

  // Billing
  priceCents   Int // Current price in paise
  billingCycle BillingCycle @default(MONTHLY)

  // Period tracking
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Razorpay
  razorpaySubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  addOn  AddOn  @relation(fields: [addOnId], references: [id])

  @@unique([clinicId, addOnType])
  @@index([clinicId])
  @@index([addOnId])
  @@index([status])
}

// Usage tracking for billing calculations
model UsageRecord {
  id       String    @id @default(cuid())
  clinicId String
  type     UsageType

  // Period this usage belongs to
  periodStart DateTime
  periodEnd   DateTime

  // Quantities
  quantity      Int // Total units used
  includedQuota Int // What was included in plan
  overageUnits  Int // Units over the included quota

  // Calculated charges (in paise)
  overageChargeCents Int @default(0)

  // For audit/debugging
  metadata Json? // Additional context

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, type, periodStart])
  @@index([clinicId])
  @@index([type])
  @@index([periodStart])
  @@index([clinicId, periodStart])
}

// Real-time usage events (for tracking before aggregation)
model UsageEvent {
  id       String    @id @default(cuid())
  clinicId String
  type     UsageType

  // Event details
  quantity  Int      @default(1)
  timestamp DateTime @default(now())

  // Reference to what generated the event
  entityType String? // Patient, Appointment, WhatsappLog, etc.
  entityId   String?

  // For deduplication
  eventKey String? // Unique key to prevent double counting

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@unique([eventKey])
  @@index([clinicId])
  @@index([type])
  @@index([timestamp])
  @@index([clinicId, type, timestamp])
}

// Discount configurations
model Discount {
  id   String       @id @default(cuid())
  type DiscountType @unique

  // Discount values
  percentOff         Int // Percentage discount (10 = 10%)
  maxCombinedPercent Int? // Max when stacking with other discounts

  // Applicability
  appliesToBase    Boolean @default(true)
  appliesToAddOns  Boolean @default(true)
  appliesToOverage Boolean @default(false)

  // Requirements
  minCommitmentMonths Int? // For commitment discounts
  minTenureMonths     Int? // For loyalty discounts

  // Display
  name        String
  description String?
  badgeText   String? // e.g., "Save 10%"

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([type])
}

// ============================================================================
// Subscription & Billing System
// ============================================================================

model Subscription {
  id             String             @id @default(cuid())
  clinicId       String             @unique
  plan           ClinicTier         @default(CORE)
  billingCycle   BillingCycle       @default(MONTHLY)
  basePriceCents Int // Base tier price in paise
  currency       String             @default("INR")
  status         SubscriptionStatus @default(ACTIVE)

  // Discounts applied
  discountsApplied     Json? // Array of { type: DiscountType, percentOff: number }
  totalDiscountPercent Int   @default(0) // Combined discount percentage

  // Usage limits from tier (cached for billing)
  includedPatients     Int @default(300)
  includedAppointments Int @default(500)
  includedStorageGB    Int @default(5)
  includedUsers        Int @default(1)

  // Razorpay integration
  razorpaySubscriptionId String? // Razorpay subscription ID
  razorpayPlanId         String? // Razorpay plan ID
  razorpayTokenId        String? // Razorpay customer token for autopay
  razorpayCustomerId     String? // Razorpay customer ID

  // Period tracking
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEnd           DateTime?
  cancelledAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Credits & proration
  creditsCents Int @default(0) // Monetary credits from proration/referrals

  // Auto-pay configuration
  autoPayEnabled        Boolean   @default(false)
  paymentMethodType     String? // CARD | BANK_TRANSFER
  lastFailedPaymentDate DateTime?
  failureRetryCount     Int       @default(0)
  graceUntil            DateTime? // 3-day grace period end date if payment fails

  // Scheduled changes (for downgrades or cycle switches)
  scheduledChange Json? // {plan, billingCycle, effectiveAt}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic    Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  payments  SubscriptionPayment[]
  reminders SubscriptionReminder[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([razorpaySubscriptionId])
}

model SubscriptionPayment {
  id             String  @id @default(cuid())
  clinicId       String
  subscriptionId String?

  amountCents Int // Amount in paise
  currency    String @default("INR")
  status      String // pending, paid, failed, refunded

  // Razorpay details
  razorpayPaymentId String?
  razorpayOrderId   String?
  razorpaySignature String?

  // Invoice details
  invoiceUrl    String?
  invoiceNumber String?

  // Proration info
  isProrated          Boolean @default(false)
  proratedDays        Int?
  originalAmountCents Int?

  // Credits applied
  creditsApplied Int @default(0)

  description   String?
  failureReason String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([clinicId])
  @@index([subscriptionId])
  @@index([status])
  @@index([razorpayPaymentId])
}

model SubscriptionReminder {
  id             String  @id @default(cuid())
  clinicId       String
  subscriptionId String?

  type    String // expiry_7d, expiry_3d, expiry_1d, expired, grace_1d, grace_2d, grace_3d
  channel String // email, whatsapp, in_app
  status  String @default("pending") // pending, sent, failed

  sentAt       DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([clinicId, type, createdAt])
  @@index([clinicId])
  @@index([type])
  @@index([status])
}

// ============================================================================
// Referral System
// ============================================================================

model Referral {
  id               String  @id @default(cuid())
  referrerClinicId String
  referredClinicId String? // null until referred clinic signs up

  referredEmail  String // Email used for invitation
  referredDomain String? // Domain extracted from email for anti-abuse
  referralCode   String // The referral code used

  status ReferralStatus @default(PENDING)

  // Discount for referred clinic
  discountPercent Int     @default(25) // 25% off first month
  discountApplied Boolean @default(false)

  // Credit for referrer
  creditMonths  Int     @default(1) // 1 free month per successful referral
  creditApplied Boolean @default(false)

  inviteSentAt    DateTime?
  signedUpAt      DateTime?
  convertedAt     DateTime? // When first payment completed
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrerClinic Clinic  @relation("ReferrerClinic", fields: [referrerClinicId], references: [id])
  referredClinic Clinic? @relation("ReferredClinic", fields: [referredClinicId], references: [id])

  @@index([referrerClinicId])
  @@index([referredClinicId])
  @@index([referredEmail])
  @@index([referralCode])
  @@index([status])
}

model ReferralCredit {
  id         String @id @default(cuid())
  clinicId   String
  referralId String

  creditMonths Int // Months credited
  appliedAt    DateTime  @default(now())
  expiresAt    DateTime? // Credits may expire
  usedAt       DateTime? // When credit was consumed

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([referralId])
}

// ============================================================================
// Device Tokens for Push Notifications
// ============================================================================

model DeviceToken {
  id         String   @id @default(cuid())
  patientId  String? // For patient app users
  userId     String? // For staff/doctor app users  
  token      String
  platform   String // ios, android, web
  deviceId   String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([token])
  @@index([patientId])
  @@index([userId])
  @@index([patientId, isActive])
  @@index([userId, isActive])
  @@index([token])
}

// ============================================================================
// Phase 2: Audit, Analytics, Payment & Import Tables
// ============================================================================

model AuditLog {
  id           String   @id @default(cuid())
  clinicId     String
  userId       String
  action       String // PRESCRIPTION_CREATED, PATIENT_UPDATED, INVOICE_PAID, etc.
  entityType   String // PRESCRIPTION, PATIENT, INVOICE, APPOINTMENT, etc.
  entityId     String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  status       String   @default("SUCCESS") // SUCCESS, FAILED, PENDING
  errorMessage String?
  metadata     Json?
  createdAt    DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([clinicId, createdAt])
}

model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  clinicId     String
  period       String // "daily", "weekly", "monthly"
  snapshotDate DateTime

  // Revenue Metrics
  totalRevenue     Decimal @default(0) @db.Decimal(12, 2)
  invoiceCount     Int     @default(0)
  avgInvoiceAmount Decimal @default(0) @db.Decimal(12, 2)

  // Appointment Metrics
  totalAppointments   Int     @default(0)
  completedAppts      Int     @default(0)
  cancelledAppts      Int     @default(0)
  appointmentFillRate Decimal @default(0) @db.Decimal(5, 2)

  // Patient Metrics
  newPatients     Int     @default(0)
  activePatients  Int     @default(0)
  appointmentRate Decimal @default(0) @db.Decimal(5, 2)

  // Condition Metrics
  topConditions Json @default("[]") // Array of {condition, count, percentage}

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, period, snapshotDate])
  @@index([clinicId])
  @@index([period])
  @@index([snapshotDate])
}

model PaymentRetry {
  id              String  @id @default(cuid())
  clinicId        String
  invoiceId       String
  razorpayOrderId String?
  razorpayLinkId  String?

  // Retry Strategy
  attemptCount   Int      @default(0)
  maxRetries     Int      @default(3)
  nextRetryAt    DateTime
  retryIntervals Int[]    @default([3600, 86400, 259200]) // 1h, 24h, 72h

  // Status
  status        String    @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED_EXHAUSTED
  lastError     String?
  lastAttemptAt DateTime?
  completedAt   DateTime?

  // Context
  paymentMethod String?
  amount        Decimal @db.Decimal(12, 2)
  phoneNumber   String? // For WhatsApp reminders

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([invoiceId])
  @@index([clinicId, status])
}

model BulkImportJob {
  id       String @id @default(cuid())
  clinicId String
  userId   String

  // Job Details
  entityType  String // PATIENT, PRESCRIPTION, DOCTOR, LAB_TEST, INVENTORY
  fileName    String
  fileSize    Int // Bytes
  originalKey String // S3 key for file storage

  // Progress
  status        String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalRows     Int
  processedRows Int    @default(0)
  successRows   Int    @default(0)
  failedRows    Int    @default(0)
  skippedRows   Int    @default(0)

  // Error Tracking
  errors       Json    @default("[]") // [{rowNumber, error, field}]
  errorSummary String? // Aggregated error summary

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // Milliseconds

  // Results
  importedIds String[] @default([])
  resultKey   String? // S3 key for result CSV

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([status])
  @@index([entityType])
  @@index([createdAt])
  @@index([clinicId, createdAt])
  @@index([userId])
}

// ============================================================================
// Billing Enums
// ============================================================================

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  GRACE
  CANCELLED
  EXPIRED
  PAUSED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

enum AddOnType {
  WHATSAPP
  INTELLIGENCE
}

enum AddOnStatus {
  ACTIVE
  TRIALING
  CANCELLED
  EXPIRED
}

enum UsageType {
  ACTIVE_PATIENTS
  APPOINTMENTS
  STORAGE_GB
  USERS
  WHATSAPP_MESSAGES
  AI_CREDITS
}

enum DiscountType {
  ANNUAL_COMMITMENT // 10% for yearly billing
  SEMI_ANNUAL_COMMITMENT // 5% for 6-month billing
  LOYALTY_1_YEAR // 5% after 1 year
  LOYALTY_2_YEARS // 7% after 2 years
  LOYALTY_3_YEARS // 10% after 3 years
  REFERRAL_NEW_CUSTOMER // 1 month free for referred
  GOVERNMENT // 30% for govt hospitals
  NGO // 40% for non-profits
  MEDICAL_COLLEGE // 50% for teaching hospitals
  RURAL_HEALTH // 40% for rural centers
  STARTUP_CLINIC // 25% for clinics < 1 year old
}

enum ReferralStatus {
  PENDING // Invite sent, waiting for signup
  SIGNED_UP // Referred clinic created account
  CONVERTED // First payment completed - credits applied
  REJECTED // Failed validation (same domain, abuse, etc.)
  EXPIRED // Invite expired without signup
}

// ============================================================================
// IPD / Bed Management Models (Hospital Only)
// ============================================================================

model Ward {
  id          String   @id @default(cuid())
  name        String // e.g., "ICU", "General Ward", "Private"
  type        String // e.g., "INTENSIVE_CARE", "GENERAL", "PRIVATE", "OXYGEN"
  description String?
  floorNumber String?
  clinicId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  rooms       Room[]

  @@index([clinicId])
}

model Room {
  id         String   @id @default(cuid())
  wardId     String
  roomNumber String
  type       String? // e.g., "SINGLE", "DOUBLE", "SHARED"
  charges    Float    @default(0) // Daily charges
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ward       Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  beds       Bed[]

  @@index([wardId])
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  RESERVED
}

model Bed {
  id         String      @id @default(cuid())
  roomId     String
  bedNumber  String
  status     BedStatus   @default(AVAILABLE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  admissions Admission[]

  @@index([roomId])
  @@index([status])
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

model Admission {
  id                String          @id @default(cuid())
  patientId         String
  bedId             String
  admittedAt        DateTime        @default(now())
  dischargedAt      DateTime?
  status            AdmissionStatus @default(ADMITTED)
  reason            String?
  diagnosis         String?
  notes             String?
  admittingDoctorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient         Patient @relation(fields: [patientId], references: [id])
  bed             Bed     @relation(fields: [bedId], references: [id])
  admittingDoctor User?   @relation(fields: [admittingDoctorId], references: [id])

  @@index([patientId])
  @@index([bedId])
  @@index([status])
}
