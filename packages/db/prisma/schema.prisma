// ---------------------------------------------------------------------------
// CANONICAL Prisma schema for the Docita workspace.
//
// This file is the SOURCE OF TRUTH consumed by Prisma CLI commands
// (`prisma generate`, `prisma migrate dev|deploy`, `prisma format`).
// Edits MUST happen here. The historical hand-maintained decomposition under
// `prisma/schema/` was retired because it could drift from this file.
//
// To verify consistency after edits: `pnpm --filter @workspace/db run db:diff`.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  password                   String
  name                       String
  role                       Role                     @default(DOCTOR)
  clinicId                   String?
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(3)
  qualification              String?
  registrationNumber         String?
  registrationCouncil        String?
  registrationStateCode      String?
  hprId                      String?
  signatureUrl               String?
  signatureUploadedAt        DateTime?                @db.Timestamptz(3)
  bio                        String?
  // Canonical money column — integer paise/cents. Prefer over the legacy
  // `consultationFee` Float (kept for backward compatibility, additive-only).
  consultationFee            Float?
  consultationFeeCents       Int?
  hospitalRole               HospitalRole?
  licenseExpiry              DateTime?                @db.Timestamptz(3)
  licenseNumber              String?
  verificationStatus         DoctorVerificationStatus @default(UNVERIFIED)
  verificationSource         String?
  verificationRef            String?
  verificationReason         String?
  /// @json:jsonObjectSchema
  verificationData           Json?
  verificationCheckedAt      DateTime?                @db.Timestamptz(3)
  registrationCertificateUrl String?
  verifiedByAdminId          String?
  verifiedByAdminAt          DateTime?                @db.Timestamptz(3)
  phoneNumber                String?
  profilePhotoUrl            String?
  specialization             Specialization?
  yearsOfExperience          Int?
  failedLoginAttempts        Int                      @default(0)
  lastFailedLoginAt          DateTime?                @db.Timestamptz(3)
  appLoginDisabled           Boolean                  @default(false)
  accountLockedUntil         DateTime?                @db.Timestamptz(3)
  mfaEnabled                 Boolean                  @default(false)
  mfaSecret                  String?
  mfaTempSecret              String?
  mfaBackupCodes             String[]                 @default([])
  passwordChangedAt          DateTime?                @db.Timestamptz(3)
  passwordExpiresAt          DateTime?                @db.Timestamptz(3)
  emailVerified              Boolean                  @default(false)
  emailVerificationToken     String?                  @unique
  emailVerificationExpiresAt DateTime?                @db.Timestamptz(3)
  passwordResetToken         String?                  @unique
  passwordResetExpiresAt     DateTime?                @db.Timestamptz(3)
  onboardingStep             OnboardingStep?          @default(NOT_STARTED)
  onboardingStartedAt        DateTime?                @db.Timestamptz(3)
  onboardingCompletedAt      DateTime?                @db.Timestamptz(3)
  guidedTourStatus           GuidedTourStatus         @default(NOT_STARTED)
  guidedTourLastStep         Int                      @default(0)
  guidedTourCompletedAt      DateTime?                @db.Timestamptz(3)
  checklistDismissedAt       DateTime?                @db.Timestamptz(3)
  deletedAt                  DateTime?                @db.Timestamptz(3)
  labId                      String?

  appointments                 Appointment[]
  auditLogs                    AuditLog[]
  bulkImportJobs               BulkImportJob[]
  certifications               DoctorCertification[]
  doctorClinics                DoctorClinic[]
  educationHistory             DoctorEducation[]
  favoriteCodes                DoctorFavoriteCode[]
  schedules                    DoctorSchedule[]
  additionalSpecializations    DoctorSpecialization[]
  timeOffs                     DoctorTimeOff[]
  feedbacks                    Feedback[]
  prescriptions                Prescription[]
  prescriptionTemplates        PrescriptionTemplate[]
  queueTokens                  QueueToken[]
  staffNotifications           StaffNotification[]
  admissions                   Admission[]
  refreshTokens                RefreshToken[]
  clinic                       Clinic?                  @relation(fields: [clinicId], references: [id])
  uploadSessions               UploadSession[]
  signatureUploadTokens        SignatureUploadToken[]
  notificationPreferences      NotificationPreferences?
  memberJoinRequests           MemberJoinRequest[]
  approvedJoinRequests         MemberJoinRequest[]      @relation("ApprovedRequests")
  passwordHistory              PasswordHistory[]
  mfaChallenges                MfaChallenge[]
  apiKeys                      ApiKey[]                 @relation("ApiKeyCreator")
  medicalDocuments             MedicalDocument[]        @relation("DoctorMedicalDocuments")
  followUps                    FollowUp[]               @relation("DoctorFollowUps")
  preferredAppointmentRequests AppointmentRequest[]     @relation("PreferredAppointmentRequestDoctor")
  reviewedAppointmentRequests  AppointmentRequest[]     @relation("ReviewedAppointmentRequests")
  staffLeaves                  StaffLeave[]             @relation("StaffLeaves")
  approvedLeaves               StaffLeave[]             @relation("ApprovedLeaves")
  linkedPatient                Patient?
  recordedMetricRecords        PatientMetricRecord[]
  patientDoctors               PatientDoctor[]          @relation("DoctorPatients")
  handledDataSubjectRequests   DataSubjectRequest[]     @relation("HandledDataSubjectRequests")
  lab                          Lab?                     @relation(fields: [labId], references: [id])

  @@index([clinicId])
  @@index([hprId])
  @@index([specialization])
  @@index([clinicId, role, createdAt], map: "User_clinicId_role_createdAt_idx")
  @@index([verificationStatus])
  @@index([deletedAt])
  @@index([labId])
}

model NotificationPreferences {
  id       String  @id @default(cuid())
  userId   String  @unique
  whatsapp Boolean @default(true)
  inApp    Boolean @default(true)
  email    Boolean @default(false)
  sms      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model SignatureUploadToken {
  id        String           @id @default(cuid())
  doctorId  String?
  token     String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  used      Boolean          @default(false)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  purpose   SignaturePurpose @default(DOCTOR_PRESCRIPTION)
  clinicId  String?

  doctor User?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation("ClinicSlaSignatureTokens", fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([expiresAt])
  @@index([clinicId])
}

model MemberJoinRequest {
  id              String            @id @default(cuid())
  userId          String
  clinicId        String
  requestedRole   Role              @default(DOCTOR)
  message         String?
  status          JoinRequestStatus @default(PENDING)
  approvedById    String?
  approvedByName  String?
  responseMessage String?
  requestedAt     DateTime          @default(now()) @db.Timestamptz(3)
  respondedAt     DateTime?         @db.Timestamptz(3)
  expiresAt       DateTime?         @db.Timestamptz(3)

  user       User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic     Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("ApprovedRequests", fields: [approvedById], references: [id])

  @@unique([userId, clinicId])
  @@index([clinicId, status])
  @@index([status])
}

model DoctorEducation {
  id           String   @id @default(cuid())
  doctorId     String
  degree       String
  fieldOfStudy String?
  institution  String
  location     String?
  startYear    Int?
  endYear      Int?
  isOngoing    Boolean  @default(false)
  grade        String?
  thesis       String?
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  doctor       User     @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId])
  @@index([endYear])
}

model DoctorCertification {
  id            String    @id @default(cuid())
  doctorId      String
  name          String
  issuingBody   String
  issueDate     DateTime  @db.Timestamptz(3)
  expiryDate    DateTime? @db.Timestamptz(3)
  credentialId  String?
  credentialUrl String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  doctor        User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([expiryDate])
}

model DoctorSpecialization {
  id              String         @id @default(cuid())
  doctorId        String
  specialization  Specialization
  isPrimary       Boolean        @default(false)
  certificationId String?
  yearsOfPractice Int?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  doctor          User           @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, specialization])
  @@index([doctorId])
  @@index([specialization])
}

model DoctorSchedule {
  id           String    @id @default(cuid())
  doctorId     String
  clinicId     String
  dayOfWeek    DayOfWeek
  startTime    String
  endTime      String
  slotDuration Int       @default(30)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId, dayOfWeek])
  @@index([doctorId])
  @@index([clinicId])
  @@index([dayOfWeek])
  @@index([clinicId, dayOfWeek, isActive], map: "DoctorSchedule_clinicId_dayOfWeek_isActive_idx")
}

model ClinicWeeklySchedule {
  id           String    @id @default(cuid())
  clinicId     String
  dayOfWeek    DayOfWeek
  startTime    String
  endTime      String
  slotDuration Int       @default(30)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@index([clinicId])
  @@index([clinicId, dayOfWeek, isActive])
}

model DoctorTimeOff {
  id        String   @id @default(cuid())
  doctorId  String
  clinicId  String?
  startDate DateTime @db.Timestamptz(3)
  endDate   DateTime @db.Timestamptz(3)
  reason    String?
  isFullDay Boolean  @default(true)
  startTime String?
  endTime   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  version   Int      @default(1)
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor    User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([clinicId])
  @@index([startDate, endDate])
  @@index([doctorId, clinicId, startDate, endDate, isFullDay])
}

model Patient {
  id                          String                       @id @default(cuid())
  mrn                         String?
  firstName                   String
  lastName                    String
  preferredName               String?
  pronouns                    String?
  dateOfBirth                 DateTime                     @db.Timestamptz(3)
  phoneNumber                 String
  email                       String?
  address                     String?
  insuranceProvider           String?
  insurancePolicyNumber       String?
  insuranceGroupNumber        String?
  medicalHistory              String[]
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  version                     Int                          @default(1)
  allergies                   String?
  bloodGroup                  String?
  clinicId                    String
  /// @json:jsonObjectSchema
  customData                  Json?                        @default("{}")
  gender                      Gender
  userId                      String?                      @unique
  user                        User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  race                        String?
  ethnicity                   String?
  preferredLanguage           String?                      @default("en")
  maritalStatus               String?
  emergencyContactName        String?
  emergencyContactPhone       String?
  emergencyContactRelation    String?
  codeStatus                  CodeStatus                   @default(FULL_CODE)
  codeStatusUpdatedAt         DateTime?                    @db.Timestamptz(3)
  codeStatusUpdatedBy         String?
  advanceDirectiveUrl         String?
  whatsappConsent             Boolean                      @default(false)
  whatsappConsentAt           DateTime?                    @db.Timestamptz(3)
  appointments                Appointment[]
  appointmentRequests         AppointmentRequest[]
  documents                   Document[]
  invoices                    Invoice[]
  clinic                      Clinic                       @relation(fields: [clinicId], references: [id])
  tags                        PatientTag[]
  paymentSessions             PaymentSession[]
  prescriptions               Prescription[]
  queueTokens                 QueueToken[]
  whatsappLogs                WhatsappLog[]
  whatsappConversations       WhatsappConversation[]
  whatsappBroadcastRecipients WhatsAppBroadcastRecipient[]
  abhaAddress                 String?
  abhaNumber                  String?
  abhaKycName                 String?
  abhaVerifiedAt              DateTime?                    @db.Timestamptz(3)
  deletedAt                   DateTime?                    @db.Timestamptz(3)
  medicalConditions           PatientMedicalCondition[]
  patientAllergies            PatientAllergy[]
  familyHistory               PatientFamilyHistory[]
  socialHistory               PatientSocialHistory?
  surgicalHistory             PatientSurgicalHistory[]
  immunizations               Immunization[]
  consents                    Consent[]
  admissions                  Admission[]
  metricDefinitions           MetricDefinition[]
  metricRecords               PatientMetricRecord[]
  metricSelections            PatientMetricSelection[]
  medicalDocuments            MedicalDocument[]
  followUps                   FollowUp[]
  medicationDoses             MedicationDose[]
  labTestOrders               LabTestOrder[]
  patientDoctors              PatientDoctor[]
  dataSubjectRequests         DataSubjectRequest[]
  insuranceClaims             InsuranceClaim[]
  abdmCareContexts            AbdmCareContext[]
  abdmTransactions            AbdmTransaction[]
  abdmConsentRequests         AbdmConsentRequest[]
  abdmExternalRecords         AbdmExternalRecord[]

  @@unique([clinicId, mrn], map: "Patient_clinicId_mrn_key")
  @@index([mrn])
  @@index([phoneNumber])
  @@index([clinicId])
  @@index([createdAt])
  @@index([clinicId, phoneNumber])
  @@index([email])
  @@index([codeStatus])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, createdAt])
  @@index([deletedAt])
  @@index([abhaAddress])
  @@index([userId])
  @@index([phoneNumber, deletedAt], map: "Patient_phoneNumber_deletedAt_idx")
  @@index([userId, deletedAt], map: "Patient_userId_deletedAt_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_lastName_trgm_idx")
  @@index([phoneNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_phoneNumber_trgm_idx")
  @@index([mrn(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_mrn_trgm_idx")
}

model PatientMedicalCondition {
  id                  String               @id @default(cuid())
  patientId           String
  conditionName       String
  icdCode             String?
  conditionType       MedicalConditionType @default(CHRONIC)
  status              ConditionStatus      @default(ACTIVE)
  severity            ConditionSeverity?
  diagnosedDate       DateTime?            @db.Timestamptz(3)
  resolvedDate        DateTime?            @db.Timestamptz(3)
  diagnosedBy         String?
  notes               String?
  sourceType          ConditionSourceType  @default(MANUAL)
  sourceAppointmentId String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([conditionType])
  @@index([status])
  @@index([icdCode])
  @@index([patientId, status], map: "PatientMedicalCondition_patientId_status_idx")
}

model PatientAllergy {
  id          String          @id @default(cuid())
  patientId   String
  allergen    String
  allergyType AllergyType     @default(DRUG)
  severity    AllergySeverity @default(MODERATE)
  reaction    String?
  onsetDate   DateTime?       @db.Timestamptz(3)
  verifiedBy  String?
  verifiedAt  DateTime?       @db.Timestamptz(3)
  isVerified  Boolean         @default(false)
  notes       String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([allergyType])
  @@index([severity])
  @@index([patientId, severity], map: "PatientAllergy_patientId_severity_idx")
}

model PatientFamilyHistory {
  id           String   @id @default(cuid())
  patientId    String
  condition    String
  relationship String
  ageAtOnset   Int?
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientSocialHistory {
  id                  String            @id @default(cuid())
  patientId           String            @unique
  smokingStatus       SmokingStatus?
  smokingPackYears    Float?
  smokingQuitDate     DateTime?         @db.Timestamptz(3)
  alcoholUse          AlcoholUseStatus?
  alcoholFrequency    String?
  substanceUse        String?
  occupation          String?
  occupationalHazards String?
  exerciseFrequency   String?
  dietaryRestrictions String?
  notes               String?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientSurgicalHistory {
  id            String    @id @default(cuid())
  patientId     String
  procedureName String
  procedureDate DateTime? @db.Timestamptz(3)
  hospital      String?
  surgeon       String?
  complications String?
  notes         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

enum MedicalConditionType {
  CHRONIC
  ACUTE
  CONGENITAL
  INFECTIOUS
  AUTOIMMUNE
  PSYCHIATRIC
  OTHER
}

enum ConditionStatus {
  ACTIVE
  MANAGED
  RESOLVED
  IN_REMISSION
}

enum ConditionSeverity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum ConditionSourceType {
  MANUAL
  AUTO_SUGGESTED
  IMPORTED
}

enum AllergyType {
  DRUG
  FOOD
  ENVIRONMENTAL
  LATEX
  INSECT
  CONTRAST
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
  UNKNOWN
}

enum AlcoholUseStatus {
  NONE
  OCCASIONAL
  MODERATE
  HEAVY
  UNKNOWN
}

enum AppointmentPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model PatientTag {
  id        String  @id @default(cuid())
  patientId String
  tag       String
  color     String  @default("blue")
  patient   Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

model UploadSession {
  id               String               @id @default(cuid())
  status           String               @default("pending")
  fileUrl          String?
  purpose          UploadSessionPurpose @default(GENERAL)
  doctorId         String?
  uploadSecretHash String?
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime             @db.Timestamptz(3)
  doctor           User?                @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([doctorId])
}

model Appointment {
  id                      String                @id @default(cuid())
  patientId               String
  doctorId                String
  startTime               DateTime              @db.Timestamptz(3)
  endTime                 DateTime              @db.Timestamptz(3)
  status                  AppointmentStatus     @default(SCHEDULED)
  type                    String
  notes                   String?
  consultationNotes       String?
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(3)
  version                 Int                   @default(1)
  clinicId                String
  observations            String?
  chiefComplaint          String?
  treatmentHistory        String?
  clinicalImpression      String?
  differentialDiagnosis   String?
  finalDiagnosis          String?
  followUpPlan            String?
  /// @json:generalExaminationSchema
  generalExamination      Json?
  historyOfPresentIllness String?
  /// @json:clinicalInvestigationSchema
  investigations          Json?
  pastMedicalHistory      String?
  provisionalDiagnosis    String?
  reviewOfSystems         String?
  /// @json:systemicExaminationSchema
  systemicExamination     Json?
  treatmentPlan           String?
  /// @json:dentalChartSchema
  dentalChart             Json?
  /// @json:growthChartDataSchema
  growthData              Json?
  /// @json:ophthalmologyExamDataSchema
  ophthalmologyExam       Json?
  /// @json:cardiologyExamDataSchema
  cardiologyExam          Json?
  /// @json:gynecologyExamDataSchema
  gynecologyExam          Json?
  /// @json:dermatologyExamDataSchema
  dermatologyExam         Json?
  /// @json:psychiatryExamDataSchema
  psychiatryExam          Json?
  encounterSummary        String?
  advanceAmountCents      Int                   @default(0)
  advancePaymentMethod    String?
  advanceReference        String?
  advanceNotes            String?
  clinic                  Clinic                @relation(fields: [clinicId], references: [id])
  doctor                  User                  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient                 Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  diagnoses               Diagnosis[]
  reminders               AppointmentReminder[]
  invoice                 Invoice?
  prescription            Prescription?
  procedures              Procedure[]
  queueToken              QueueToken?
  insuranceClaims         InsuranceClaim[]
  vitalSign               VitalSign?
  priority                AppointmentPriority   @default(ROUTINE)
  responses               AppointmentResponse[]
  metricRecords           PatientMetricRecord[]
  followUps               FollowUp[]
  originalStartTime       DateTime?             @db.Timestamptz(3)

  @@index([clinicId])
  @@index([createdAt])
  @@index([startTime])
  @@index([doctorId, startTime])
  @@index([patientId, startTime])
  @@index([status, startTime])
  @@index([doctorId])
  @@index([patientId])
  @@index([clinicId, status, startTime])
  @@index([clinicId, startTime(sort: Desc), id(sort: Desc)], map: "Appointment_clinicId_startTime_id_idx")
  @@index([patientId, clinicId, startTime(sort: Desc)], map: "Appointment_patientId_clinicId_startTime_idx")
  @@index([doctorId, clinicId, startTime(sort: Desc)], map: "Appointment_doctorId_clinicId_startTime_idx")
  @@index([notes(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_notes_trgm_idx")
  @@index([chiefComplaint(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_chiefComplaint_trgm_idx")
}

model DoctorDelay {
  id           String    @id @default(cuid())
  clinicId     String
  doctorId     String
  delayMinutes Int
  reason       String?
  isActive     Boolean   @default(true)
  markedById   String
  markedAt     DateTime  @default(now()) @db.Timestamptz(3)
  clearedAt    DateTime? @db.Timestamptz(3)
  clearedById  String?

  @@index([clinicId, isActive])
  @@index([doctorId, isActive])
  @@index([markedAt])
}

model VitalSign {
  id                String             @id @default(cuid())
  appointmentId     String             @unique
  clinicId          String?
  height            Float?
  weight            Float?
  bloodPressure     String?
  systolicBP        Int?
  diastolicBP       Int?
  bpPosition        BpPosition?
  bpMigrationStatus BpMigrationStatus?

  pulse          Int?
  temperature    Float?
  spo2           Int?
  oxygenDelivery OxygenDelivery?
  oxygenFlowRate Float?

  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  bloodGlucose       Float?
  bmi                Float?
  notes              String?
  painScore          Int?
