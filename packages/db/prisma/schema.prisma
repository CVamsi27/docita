enum PdfJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PdfJob {
  id           String       @id @default(cuid())
  clinicId     String
  documentId   String
  documentType String
  status       PdfJobStatus @default(PENDING)
  pdfUrl       String?
  failedReason String?
  attemptsMade Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  completedAt  DateTime?
  clinic       Clinic       @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, documentId, documentType])
  @@index([clinicId])
  @@index([status])
  @@index([documentId, documentType])
}

enum QueueJobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  DEAD_LETTERED
}

model QueueJob {
  id             String         @id @default(cuid())
  name           String
  /// @json:jsonObjectSchema
  data           Json
  status         QueueJobStatus @default(WAITING)
  priority       Int            @default(0)
  attemptsMade   Int            @default(0)
  maxAttempts    Int            @default(5)
  failedReason   String?
  processedAt    DateTime?
  delayedUntil   DateTime?
  idempotencyKey String?
  completedAt    DateTime?
  deadLetteredAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  @@index([name, status])
  @@index([name, status, priority(sort: Desc), createdAt], map: "QueueJob_name_status_priority_createdAt_idx")
  @@index([status, delayedUntil])
  @@index([createdAt])
  @@index([name, idempotencyKey, completedAt(sort: Desc)], map: "QueueJob_idempotency_lookup_idx")
}

enum ApiHttpIdempotencyStatus {
  PROCESSING
  COMPLETED
}

/// Cross-replica HTTP idempotency for POST mutations (Idempotency-Key header).
/// Rows are purged after recordExpiresAt by EphemeralStoreCleanupScheduler.
model ApiHttpIdempotencyRecord {
  id                    String                   @id @default(cuid())
  scopedKey             String                   @unique
  bodyHash              String
  status                ApiHttpIdempotencyStatus
  /// @json:apiHttpIdempotencyResponseJsonSchema
  response              Json?
  processingExpiresAt   DateTime
  recordExpiresAt       DateTime
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([recordExpiresAt])
  @@index([status, processingExpiresAt])
}

/// Short-lived dedupe for verified webhook deliveries (replay protection).
model WebhookReplayDedupe {
  id            String   @id @default(cuid())
  dedupeKeyHash String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}
