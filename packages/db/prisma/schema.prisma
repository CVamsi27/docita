  payload        Json
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  processedAt    DateTime? @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?
  // Exponential-backoff bookkeeping for the relay: nextAttemptAt gates when
  // the row becomes eligible again after a failure, lastAttemptAt tracks the
  // most recent dispatch try (set by the atomic claim step).
  nextAttemptAt  DateTime? @db.Timestamptz(3)
  lastAttemptAt  DateTime? @db.Timestamptz(3)

  @@index([processedAt, createdAt])
  @@index([clinicId])
  @@index([eventName])
  @@index([processedAt, nextAttemptAt])
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  SOFT_BOUNCE
  COMPLAINT
  UNSUBSCRIBE
}

