  Q6H // Every 6 hours
  Q8H // Every 8 hours
  Q12H // Every 12 hours
  QHS // At bedtime
  QAM // Every morning
  QPM // Every evening
  QOD // Every other day
  QWK // Once weekly
  PRN // As needed
  STAT // Immediately
  AC // Before meals
  PC // After meals
  OTHER
