enum FollowUpStatus {
  PENDING
  REMINDER_SENT
  BOOKED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum AppointmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AppointmentRequest {
  id                 String                   @id @default(cuid())
  patientId          String
  clinicId           String
  preferredDoctorId  String?
  preferredDate      DateTime
  preferredTime      String?
  requestedSlotStart DateTime?
  requestedSlotEnd   DateTime?
  reason             String
  notes              String?
  status             AppointmentRequestStatus @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  responseMessage    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic          Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  preferredDoctor User?   @relation("PreferredAppointmentRequestDoctor", fields: [preferredDoctorId], references: [id], onDelete: SetNull)
  reviewedBy      User?   @relation("ReviewedAppointmentRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([clinicId, status, createdAt])
  @@index([clinicId, status, preferredDate])
  @@index([patientId, status])
  @@index([preferredDoctorId])
  @@index([reviewedById])
}

