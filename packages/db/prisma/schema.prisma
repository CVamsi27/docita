/// A referral partner. CLINIC referrers earn free-month credits; PHARMACY /
/// MARKETING_PERSON / CUSTOM earn cash revenue-share of the referred clinic's
/// first-year billing. Terms are stored as JSON so per-referrer overrides are
/// possible without a schema change (see referral-reward.rules.ts).
model Referrer {
  id         String             @id @default(cuid())
  type       ReferrerType
  rewardKind ReferrerRewardKind
  name       String
  email      String?
  phone      String?
  /// Set when type = CLINIC (the referring clinic).
  clinicId   String?
  /// @json:referrerRateBandsJsonSchema
  rateBands    Json?
  /// @json:referrerCreditConfigJsonSchema
  creditConfig Json?
  /// @json:referrerPayoutDetailsJsonSchema
  payoutDetails Json?
  firstYearOnly Boolean @default(true)
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  referrals Referral[]
  payouts   ReferralPayout[]

  @@index([type])
  @@index([clinicId])
  @@index([active])
}

/// Idempotent revenue-share accrual ledger for one referred clinic + billing
/// period. `@@unique([referralId, periodStart])` guarantees a scheduler re-run
/// never double-pays. Disbursed manually (status -> PAID) from the internal app.
model ReferralPayout {
  id         String @id @default(cuid())
  referralId String
  referrerId String

  periodStart DateTime @db.Timestamptz(3)
  periodEnd   DateTime @db.Timestamptz(3)

  baseRevenueCents Int
  ratePercent      Int
  amountCents      Int

  status ReferralPayoutStatus @default(PENDING)
  paidAt DateTime?            @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  referral Referral @relation(fields: [referralId], references: [id])
  referrer Referrer @relation(fields: [referrerId], references: [id])

  @@unique([referralId, periodStart])
  @@index([referrerId])
  @@index([status])
}

