  correctedValue String
  confidence     Float?
  helpful        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([ocrDocumentId])
  @@index([clinicId])
  @@index([fieldName])
}

