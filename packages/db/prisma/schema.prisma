enum BpMigrationStatus {
  PENDING // Not yet migrated
  MIGRATED // Successfully parsed and migrated
  FLAGGED // Non-standard format, needs manual review
  MANUAL // Manually corrected
}

// Dosage Form - Pharmaceutical dosage forms
