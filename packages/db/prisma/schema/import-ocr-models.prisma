model ImportJob {
  id            String          @id @default(cuid())
  clinicId      String
  type          ImportJobType
  status        ImportJobStatus @default(PENDING)
  fileName      String?
  fileUrl       String?
  columnMapping Json?
  totalRecords  Int             @default(0)
  processed     Int             @default(0)
  successful    Int             @default(0)
  failed        Int             @default(0)
  errors        Json?
  results       Json?
  createdBy     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  completedAt   DateTime?
  clinic        Clinic          @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([status])
}

model OcrDocument {
  id                    String            @id @default(cuid())
  clinicId              String
  patientId             String?
  sourceUrl             String
  processedUrl          String?
  documentType          String            @default("UNKNOWN")
  ocrText               String?
  extractedData         Json?
  confidence            Float?
  fieldConfidenceScores Json? // Per-field confidence scores
  suggestedCorrections  Json? // AI-suggested corrections
  status                OcrDocumentStatus @default(PENDING)
  reviewedBy            String?
  reviewedAt            DateTime?
  corrections           Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relationship to feedback for learning
  feedbacks OcrFeedback[]

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
  @@index([documentType])
}

model OcrFeedback {
  id             String      @id @default(cuid())
  ocrDocumentId  String
  ocrDocument    OcrDocument @relation(fields: [ocrDocumentId], references: [id], onDelete: Cascade)
  clinicId       String
  providedBy     String // Staff member who made correction
  fieldName      String // Which field was corrected
  originalValue  String
  correctedValue String
  confidence     Float? // Original confidence score
  helpful        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([ocrDocumentId])
  @@index([clinicId])
  @@index([fieldName])
}

model PatientMergeSuggestion {
  id              String    @id @default(cuid())
  clinicId        String
  patient1Id      String
  patient2Id      String
  similarityScore Float
  matchReasons    Json
  status          String    @default("pending")
  mergedBy        String?
  mergedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@unique([patient1Id, patient2Id])
  @@index([clinicId])
  @@index([status])
}