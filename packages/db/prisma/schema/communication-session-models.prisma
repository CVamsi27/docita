model PaymentSession {
  id                String               @id @default(cuid())
  clinicId          String
  invoiceId         String?
  patientId         String?
  provider          String               @default("razorpay")
  providerSessionId String?
  providerPaymentId String?
  paymentLink       String?
  shortUrl          String?
  amount            Int
  currency          String               @default("INR")
  status            PaymentSessionStatus @default(CREATED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  paidAt            DateTime?
  failedAt          DateTime?
  expiresAt         DateTime?
  webhookPayload    Json?
  meta              Json?
  whatsappSentAt    DateTime?
  whatsappMessageId String?
  whatsappStatus    String?
  clinic            Clinic               @relation(fields: [clinicId], references: [id])
  invoice           Invoice?             @relation(fields: [invoiceId], references: [id])
  patient           Patient?             @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([invoiceId])
  @@index([providerPaymentId])
  @@index([providerSessionId])
  @@index([status])
  @@unique([provider, providerPaymentId], map: "PaymentSession_provider_providerPaymentId_key")
}

model WhatsappLog {
  id                String            @id @default(cuid())
  clinicId          String
  patientId         String?
  paymentSessionId  String?
  invoiceId         String?
  prescriptionId    String?
  type              String
  provider          String            @default("meta")
  providerMessageId String?
  phoneNumber       String
  message           String
  status            WhatsappLogStatus @default(QUEUED)
  senderPhoneNumberId String?
  senderMode          WhatsappSenderMode @default(SHARED)
  requestBody       Json?
  responseBody      Json?
  errorMessage      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deliveredAt       DateTime?
  clinic            Clinic            @relation(fields: [clinicId], references: [id])
  patient           Patient?          @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([paymentSessionId])
  @@index([invoiceId])
  @@index([prescriptionId])
  @@index([status])
  @@index([senderPhoneNumberId])
}

// WhatsApp Message Templates (for button-first approach)
model WhatsappTemplate {
  id             String                   @id @default(cuid())
  clinicId       String?
  name           String // e.g., "appointment_reminder_30min"
  category       WhatsappTemplateCategory
  content        String // Template text with {{variables}}
  variables      Json? // Array of variable names
  buttonType     WhatsappButtonType       @default(NONE)
  buttons        Json? // Button configuration
  status         WhatsappTemplateStatus   @default(DRAFT)
  metaTemplateId String? // Meta WhatsApp template ID (for production)
  version        Int                      @default(1)
  isActive       Boolean                  @default(true)
  isDefault      Boolean                  @default(false) // System default template
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  clinic         Clinic?                  @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, name, version])
  @@index([clinicId])
  @@index([category])
  @@index([status])
  @@index([isActive])
}

// Patient responses to appointment reminders
model AppointmentResponse {
  id              String              @id @default(cuid())
  appointmentId   String
  responseType    PatientResponseType
  responseTime    DateTime            @default(now())
  patientMessage  String? // Original message if text response
  delayMinutes    Int? // If DELAY, how many minutes
  staffNotified   Boolean             @default(false)
  staffNotifiedAt DateTime?
  handledById     String? // Staff member who handled
  handledAt       DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  appointment     Appointment         @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([responseType])
  @@index([staffNotified])
  @@index([createdAt])
}

// In-app notifications for staff
model StaffNotification {
  id        String                @id @default(cuid())
  clinicId  String
  userId    String? // Target staff member (null = all staff)
  type      StaffNotificationType
  title     String
  message   String
  data      Json? // Additional context (appointmentId, patientId, etc.)
  priority  NotificationPriority  @default(NORMAL)
  isRead    Boolean               @default(false)
  readAt    DateTime?
  createdAt DateTime              @default(now())
  clinic    Clinic                @relation(fields: [clinicId], references: [id])
  user      User?                 @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}
