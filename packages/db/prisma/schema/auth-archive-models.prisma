model RefreshToken {
  id              String    @id @default(cuid())
  token           String    @unique
  expiresAt       DateTime
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt       DateTime?
  replacedByToken String? // ID of the token that replaced this one
  tokenFamily     String? // Family ID for detecting token reuse attacks (same family = valid rotation chain)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@index([tokenFamily]) // Index for token reuse attack detection
}

// --- Archival Tables (§6.3) ---

model AuditLogArchive {
  id           String   @id
  clinicId     String
  userId       String
  action       String
  entityType   String
  entityId     String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  status       String
  errorMessage String?
  metadata     Json?
  createdAt    DateTime
  archivedAt   DateTime @default(now())

  @@index([clinicId])
  @@index([entityId])
  @@index([createdAt])
}

model WhatsappLogArchive {
  id                String    @id
  clinicId          String
  patientId         String?
  paymentSessionId  String?
  invoiceId         String?
  prescriptionId    String?
  type              String
  provider          String
  providerMessageId String?
  phoneNumber       String
  message           String
  status            String
  requestBody       Json?
  responseBody      Json?
  errorMessage      String?
  createdAt         DateTime
  updatedAt         DateTime
  deliveredAt       DateTime?
  archivedAt        DateTime  @default(now())

  @@index([clinicId])
  @@index([phoneNumber])
  @@index([createdAt])
}

model AppointmentArchive {
  id                      String              @id
  patientId               String
  doctorId                String
  startTime               DateTime
  endTime                 DateTime
  status                  String
  type                    String
  notes                   String?
  consultationNotes       String?
  createdAt               DateTime
  updatedAt               DateTime
  clinicId                String
  observations            String?
  chiefComplaint          String?
  treatmentHistory        String?
  clinicalImpression      String?
  differentialDiagnosis   String?
  finalDiagnosis          String?
  followUpPlan            String?
  generalExamination      Json?
  historyOfPresentIllness String?
  investigations          Json?
  pastMedicalHistory      String?
  provisionalDiagnosis    String?
  reviewOfSystems         String?
  systemicExamination     Json?
  treatmentPlan           String?
  dentalChart             Json?
  growthData              Json?
  ophthalmologyExam       Json?
  cardiologyExam          Json?
  gynecologyExam          Json?
  dermatologyExam         Json?
  psychiatryExam          Json?
  encounterSummary        String?
  priority                AppointmentPriority
  archivedAt              DateTime            @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([startTime])
}
