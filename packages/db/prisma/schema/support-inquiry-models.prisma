// ============================================================================
// Support Inbox
// ============================================================================

enum SupportInquiryStatus {
  NEW
  REVIEWED
  RESOLVED
  ARCHIVED
}

model SupportInquiry {
  id       String               @id @default(cuid())
  name     String
  email    String
  clinic   String?
  message  String
  status   SupportInquiryStatus @default(NEW)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  reviewedAt DateTime?
  reviewedBy String?
  internalNotes String?

  @@index([status])
  @@index([createdAt])
  @@index([email])
}
