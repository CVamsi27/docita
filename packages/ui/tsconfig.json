{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/ui/*": ["./src/*"],
      "@workspace/utils": ["../utils/src/index.ts"],
      "@workspace/utils/*": ["../utils/src/*"],
      "@/*": ["./src/*"]
    },
    "module": "esnext",
    "moduleResolution": "Bundler"
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
