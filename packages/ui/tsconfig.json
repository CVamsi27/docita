{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/ui/*": [
        "./src/*"
      ],
      "@workspace/types": [
        "../types/src/index.ts"
      ],
      "@workspace/types/*": [
        "../types/src/*"
      ],
      "@workspace/utils": [
        "../utils/src/index.ts"
      ],
      "@workspace/utils/*": [
        "../utils/src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "module": "esnext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
