{
  "name": "@workspace/types",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "import": "./dist/access/index.js",
      "require": "./dist/access/index.cjs"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.js",
      "require": "./dist/billing/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/access/index.ts src/billing/index.ts src/shared/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@workspace/eslint-config": "workspace:^",
    "eslint": "^9",
    "tsup": "^8.0.1",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
