{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/db/backup-database.mjs",
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "duplicates": {
    "minTokens": 300,
    "minOccurrences": 5,
    "ignore": [
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.mjs",
      "**/*.spec.mjs",
      "**/e2e/**"
    ]
  },
  "rules": {
    "unused-dependencies": "off",
    "circular-dependencies": "off",
    "unlisted-dependencies": "off"
  },
  "ignoreDependencies": [
    "@nestjs/schematics",
    "@workspace/db",
    "@workspace/auth",
    "supertest",
    "tsconfig-paths",
    "axe-playwright"
  ],
  "ignorePatterns": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.spec.mjs",
    "**/e2e/**",
    "**/test/**",
    "apps/api/src/test-utils/**",
    "**/next-env.d.ts",
    "docs/**"
  ],
  "ignoreUnresolvedImports": [
    "**/.next/types/**"
  ],
  "health": {
    "maxCyclomatic": 9999,
    "maxCognitive": 9999,
    "maxCrap": 999999
  }
}
