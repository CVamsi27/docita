{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "files": "off",
    "exports": "warn",
    "duplicates": "error",
    "enumMembers": "warn",
    "types": "warn"
  },
  "ignoreBinaries": ["printf", "tsx"],
  "ignoreWorkspaces": ["apps/worker"],
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.module.ts",
        "src/**/*.controller.ts",
        "src/**/*.guard.ts",
        "src/**/*.interceptor.ts",
        "src/**/*.decorator.ts",
        "src/**/*.middleware.ts",
        "src/**/*.filter.ts",
        "src/**/*.pipe.ts",
        "src/**/*.strategy.ts",
        "src/**/*.cron.ts",
        "src/**/*.processor.ts",
        "src/**/*.gateway.ts",
        "src/**/*.dto.ts",
        "src/**/*.entity.ts",
        "src/**/*.port.ts",
        "src/**/*.spec.ts",
        "src/seed/**/*.ts",
        "scripts/*.ts",
        "test/**/*.ts"
      ],
      "paths": {
        "@/*": ["./src/*"]
      },
      "ignore": [
        "src/common/extensions/**",
        "src/common/pagination.helper.ts",
        "src/common/types/common.types.ts",
        "src/domains/subscriptions/core/**",
        "src/domains/subscriptions/application/use-cases/**",
        "src/shared/modules/idempotency/**",
        "src/shared/modules/cache/**",
        "src/shared/modules/error-handling/sentry.utils.ts",
        "src/shared/modules/ai-core/schemas/**",
        "src/shared/modules/services/**",
        "src/shared/modules/queue/queue.interface.ts",
        "src/shared/modules/search/search.service.ts",
        "src/shared/modules/document-generation/pdf/**",
        "src/shared/modules/error-handling/logger.service.ts",
        "src/shared/modules/feature-flags/feature-flags.service.ts",
        "src/shared/modules/imports/**",
        "src/shared/modules/messaging/**",
        "src/shared/modules/monitoring/**",
        "src/shared/modules/auth/**",
        "src/shared/modules/compliance/**",
        "src/shared/modules/database/**",
        "src/gateways/**",
        "src/domains/analytics/factories/**",
        "src/domains/appointments/core/domain-services/**",
        "src/domains/billing/application/services/retry.service.ts",
        "src/domains/billing/core/services/billing-calculator.service.ts",
        "src/domains/billing/core/services/tax-calculator.service.ts",
        "src/domains/billing/core/entities/**",
        "src/domains/billing/core/utils/**",
        "src/domains/documents/**",
        "src/domains/payments/core/ports/**",
        "src/domains/whatsapp/core/**",
        "src/domains/whatsapp/application/**",
        "src/domains/webhooks/**",
        "src/domains/subscriptions/application/ports/**",
        "src/domains/subscriptions/application/services/subscription-checkout-pricing.service.ts",
        "src/shared/modules/ai/ask-ai.service.ts",
        "src/shared/modules/audit/**",
        "src/domains/payments/infrastructure/**",
        "src/domains/prescriptions/core/**",
        "src/domains/public-booking/application/services/public-booking-token.service.ts",
        "src/domains/public-booking/application/services/public-booking-utils.ts",
        "src/providers/**",
        "src/domains/clinical/application/services/clinical-settings.service.ts",
        "src/domains/clinics/application/services/onboarding/onboarding-step-engine.ts",
        "src/domains/clinics/application/services/onboarding/type-helpers.ts",
        "src/shared/modules/schedule/cron-heartbeat.ts",
        "src/shared/common/context/request-context.store.ts",
        "src/shared/modules/rls/active-tx.storage.ts",
        "src/domains/appointments/application/types/appointment-access-context.ts",
        "src/shared/common/repositories/base-repository.types.ts",
        "src/shared/common/repositories/base-repository.utils.ts",
        "src/shared/common/repositories/base.repository.ts",
        "src/shared/common/repositories/repository-domain-item.boundary.ts",
        "src/shared/modules/error-handling/exceptions/application.exception.ts",
        "src/shared/modules/error-handling/exceptions/resource.exceptions.ts",
        "src/shared/modules/error-handling/exceptions/validation.exception.ts",
        "src/test-utils/factories.ts",
        "src/domains/whatsapp/presentation/controllers/legacy-whatsapp-clinic.helpers.ts"
      ],
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/types": {
      "ignore": [
        "src/auth/mfa.ts",
        "src/shared/auth.ts"
      ]
    },
    "packages/utils": {
      "ignoreDependencies": ["clsx", "tailwind-merge"]
    },
    "packages/data-access": {
      "ignore": ["src/lib/retry.ts"]
    },
    "apps/app": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "features/**/*.{ts,tsx}",
        "shared/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ],
      "paths": {
        "@/*": ["./*"],
        "@/lib/*": ["./shared/lib/*"],
        "@/hooks/*": ["./shared/hooks/*"],
        "@/components/*": ["./shared/components/*"]
      },
      "ignore": [
        "open-next.config.ts"
      ],
      "ignoreDependencies": [
        "@tailwindcss/postcss",
        "@types/react-signature-canvas",
        "globals"
      ]
    },
    "apps/internal": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "features/**/*.{ts,tsx}",
        "shared/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ],
      "paths": {
        "@/*": ["./*"],
        "@/components/*": ["./shared/components/*"],
        "@/hooks/*": ["./shared/hooks/*"],
        "@/lib/*": ["./shared/lib/*"]
      },
      "ignoreDependencies": ["@fontsource/fraunces", "@fontsource/inter", "@fontsource/jetbrains-mono"],
      "ignore": [
        "open-next.config.ts",
        "lib/query-keys.ts"
      ]
    },
    "apps/landing": {
      "entry": [
        "src/pages/**/*.astro",
        "src/lib/api-fetch.ts"
      ],
      "ignoreDependencies": ["tailwindcss", "sharp"]
    },
    ".": {
      "entry": [
        "vitest.shared.config.ts"
      ],
      "ignore": [
        "packages/db/prisma/schema.prisma",
        "scripts/deploy/cloudflare-stubs/sentry-nextjs-cloudflare.ts"
      ],
      "ignoreDependencies": [
        "fallow",
        "madge",
        "playwright",
        "ts-node"
      ]
    },
    "packages/eslint-config": {
      "ignoreDependencies": [
        "@typescript-eslint/parser"
      ]
    },
    "packages/ui": {
      "ignore": [
        "src/components/feedback/error-boundary.tsx",
        "src/components/form/debounced-search-input.tsx"
      ],
      "ignoreDependencies": [
        "@hookform/resolvers",
        "zod",
        "@tailwindcss/postcss"
      ]
    }
  }
}
