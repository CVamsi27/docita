{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "files": "off",
    "exports": "error",
    "duplicates": "error",
    "enumMembers": "warn",
    "types": "warn"
  },
  "ignoreBinaries": ["printf", "tsx"],
  "ignoreWorkspaces": ["apps/worker"],
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/main.ts",
        "scripts/*.ts",
        "test/setup.ts",
        "test/**/*.e2e-spec.ts"
      ],
      "paths": {
        "@/*": ["./src/*"]
      },
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/utils": {
      "ignoreDependencies": ["clsx", "tailwind-merge"]
    },
    "apps/app": {
      "ignoreDependencies": [
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "@types/react-signature-canvas",
        "baseline-browser-mapping",
        "globals",
        "import-in-the-middle",
        "require-in-the-middle"
      ]
    },
    "apps/internal": {
      "ignoreDependencies": [
        "@axe-core/playwright",
        "eslint-config-next",
        "@fontsource/fraunces",
        "@fontsource/inter",
        "@fontsource/jetbrains-mono"
      ]
    },
    "apps/landing": {
      "ignoreDependencies": ["tailwindcss"],
      // Astro routing causes false-positive export/duplicate detections — ignore all exports from landing pages
      "ignore": ["apps/landing/src/pages/**", "apps/landing/src/layouts/**"]
    },
    "packages/data-access": {
      "ignoreDependencies": ["@workspace/types"]
    },
    ".": {
      "ignoreDependencies": [
        "@axe-core/playwright",
        "@workspace/eslint-config",
        "axe-core",
        "axe-playwright",
        "baseline-browser-mapping",
        "playwright",
        "ts-node"
      ]
    },
    "packages/eslint-config": {
      "ignoreDependencies": [
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser"
      ]
    },
    "packages/ui": {
      "ignoreDependencies": [
        "@hookform/resolvers",
        "zod",
        "@tailwindcss/postcss",
        "@turbo/gen"
      ]
    }
  }
}
