{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "files": "off",
    "exports": "warn",
    "duplicates": "error",
    "enumMembers": "warn",
    "types": "warn"
  },
  "ignoreBinaries": ["printf", "tsx"],
  "workspaces": {
    "apps/worker": {
      "entry": [
        "src/main.ts",
        "src/**/*.spec.js"
      ],
      "paths": {
        "@/*": ["./../api/src/*"]
      },
      "ignoreDependencies": [
        "@aws-sdk/client-s3",
        "@aws-sdk/s3-request-presigner",
        "@nestjs/cache-manager",
        "@nestjs/config",
        "@nestjs/event-emitter",
        "@nestjs/jwt",
        "@nestjs/passport",
        "@nestjs/schedule",
        "@nestjs/serve-static",
        "@nestjs/swagger",
        "@nestjs/terminus",
        "@nestjs/throttler",
        "@prisma/adapter-pg",
        "@sentry/profiling-node",
        "@willsoto/nestjs-prometheus",
        "@workspace/types",
        // worker tsconfig maps @/* to ../api/src/* and main.ts imports API
        // config services, so the worker's tsc resolves API files that import
        // @workspace/authorization — required for type resolution even though
        // no worker file imports it directly.
        "@workspace/authorization",
        "@workspace/db",
        "@workspace/utils",
        "bcrypt",
        "cache-manager",
        "compression",
        "cookie-parser",
        "dotenv",
        "exceljs",
        "express",
        "helmet",
        "nanoid",
        "nestjs-zod",
        "otplib",
        "papaparse",
        "passport",
        "passport-jwt",
        "pdfkit",
        "pg",
        "prom-client",
        "qrcode",
        "razorpay",
        "sharp",
        "socket.io",
        "zod"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.module.ts",
        "src/**/*.controller.ts",
        "src/**/*.guard.ts",
        "src/**/*.interceptor.ts",
        "src/**/*.decorator.ts",
        "src/**/*.middleware.ts",
        "src/**/*.filter.ts",
        "src/**/*.pipe.ts",
        "src/**/*.strategy.ts",
        "src/**/*.cron.ts",
        "src/**/*.processor.ts",
        "src/**/*.gateway.ts",
        "src/**/*.dto.ts",
        "src/**/*.entity.ts",
        "src/**/*.port.ts",
        "src/**/*.spec.ts",
        "src/seed/**/*.ts",
        "scripts/*.ts",
        "test/**/*.ts"
      ],
      "paths": {
        "@/*": ["./src/*"]
      },
      "ignore": [
        // base-repository.types.ts types are re-exported through
        // base.repository.ts / base-repository.core.ts. Knip sees no
        // direct external consumer of the types file because the
        // entry patterns (.module.ts / .controller.ts / etc.) never
        // import types — they consume them transitively via
        // BaseRepository<T> instantiation. The exports are live.
        "src/shared/common/repositories/base-repository.types.ts"
      ],
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/utils": {
      "ignoreDependencies": ["clsx", "tailwind-merge"]
    },
    "packages/data-access": {
      "ignore": ["src/lib/retry.ts"]
    },
    "apps/landing": {
      "playwright": false,
      "entry": [
        "src/pages/**/*.astro",
        "src/lib/api-fetch.ts"
      ],
      "ignoreDependencies": ["tailwindcss", "sharp"]
    },
    "apps/app": {
      "entry": [
        "src/**/*.tsx"
      ],
      "ignore": [
        "src/test-utils/**"
      ]
    },
    "apps/internal": {
      "entry": [
        "src/**/*.tsx"
      ]
    },
    ".": {
      "entry": [
        "vitest.shared.config.ts"
      ],
      "ignore": [
        "packages/db/prisma/schema.prisma"
      ],
      "ignoreDependencies": [
        "fallow",
        "madge",
        "playwright",
        "ts-node"
      ]
    },
    "packages/eslint-config": {
      "ignoreDependencies": [
        "@typescript-eslint/parser"
      ]
    },
    "packages/ui": {
      "ignore": [
        "src/components/feedback/error-boundary.tsx",
        "src/components/form/debounced-search-input.tsx",
        "src/components/form/form-primitives.tsx"
      ],
      "ignoreDependencies": [
        "@hookform/resolvers",
        "zod",
        "@tailwindcss/postcss"
      ]
    }
  }
}
