# X (Twitter) API credentials — OAuth 1.0a
# Get these from: developer.twitter.com → Your App → Keys and Tokens → Authentication Tokens
#
# X_APP_KEY        = API Key (Consumer Key)
# X_APP_SECRET     = API Key Secret (Consumer Secret)
# X_ACCESS_TOKEN   = Access Token  ← must start with your numeric user ID (e.g. 1234567890-...)
#                    NOT the Bearer Token (starts with AAAA...)
#                    NOT the OAuth 2.0 Client ID (base64-looking)
# X_ACCESS_SECRET  = Access Token Secret

X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn API credentials — OAuth 2.0
# Get these from: linkedin.com/developers → Your App → Auth tab
# 1. Create an app at https://www.linkedin.com/developers/apps
# 2. Request the "Share on LinkedIn" product
# 3. Generate an OAuth 2.0 access token with w_member_social scope
# 4. Find your person URN at https://www.linkedin.com/in/{your-profile} → View page source → search "memberId"
#
# LINKEDIN_ACCESS_TOKEN  = OAuth 2.0 access token (long-lived or short-lived)
# LINKEDIN_PERSON_URN    = Your LinkedIn member ID (numeric, from profile URL or API)

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
