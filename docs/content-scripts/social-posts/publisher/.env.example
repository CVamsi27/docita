# X (Twitter) API credentials — OAuth 1.0a
# Get these from: developer.twitter.com → Your App → Keys and Tokens → Authentication Tokens
#
# X_APP_KEY        = API Key (Consumer Key)
# X_APP_SECRET     = API Key Secret (Consumer Secret)
# X_ACCESS_TOKEN   = Access Token  ← must start with your numeric user ID (e.g. 1234567890-...)
#                    NOT the Bearer Token (starts with AAAA...)
#                    NOT the OAuth 2.0 Client ID (base64-looking)
# X_ACCESS_SECRET  = Access Token Secret

X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
