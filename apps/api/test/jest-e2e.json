{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "(app|appointments|compliance|dashboard|rbac)\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "esModuleInterop": true,
          "allowSyntheticDefaultImports": true,
          "moduleResolution": "node"
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@workspace/db$": "<rootDir>/../../../packages/db/src/index.ts",
    "^@workspace/db/(.*)$": "<rootDir>/../../../packages/db/src/$1",
    "^@workspace/types$": "<rootDir>/../../../packages/types/src/index.ts",
    "^@workspace/types/(.*)$": "<rootDir>/../../../packages/types/src/$1",
    "^@workspace/utils$": "<rootDir>/../../../packages/utils/src/index.ts",
    "^@workspace/utils/(.*)$": "<rootDir>/../../../packages/utils/src/$1",
    "^@workspace/(.*)$": "<rootDir>/../../../packages/$1/src/index.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "setupFiles": ["./setup-env.ts"],
  "collectCoverageFrom": [
    "../src/**/*.ts",
    "!../src/main.ts",
    "!../src/**/*.module.ts"
  ],
  "coverageDirectory": "../coverage-e2e",
  "testTimeout": 30000,
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/dist/",
    "critical-user-flow\\.e2e-spec\\.ts$",
    "rbac-authorization\\.e2e-spec\\.ts$",
    "rbac-403-verification\\.e2e-spec\\.ts$",
    "patients\\.e2e-spec\\.ts$",
    "invoices\\.e2e-spec\\.ts$",
    "prescriptions\\.e2e-spec\\.ts$",
    "subscription\\.e2e-spec\\.ts$"
  ],
  "maxWorkers": 1,
  "forceExit": true
}
