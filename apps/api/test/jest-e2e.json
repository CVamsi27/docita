{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "esModuleInterop": true,
          "allowSyntheticDefaultImports": true,
          "moduleResolution": "node"
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@workspace/db$": "<rootDir>/../../../packages/db/src/index.ts",
    "^@workspace/db/(.*)$": "<rootDir>/../../../packages/db/src/$1",
    "^@workspace/types$": "<rootDir>/../../../packages/types/src/index.ts",
    "^@workspace/types/(.*)$": "<rootDir>/../../../packages/types/src/$1",
    "^@workspace/utils$": "<rootDir>/../../../packages/utils/src/index.ts",
    "^@workspace/utils/(.*)$": "<rootDir>/../../../packages/utils/src/$1",
    "^@workspace/(.*)$": "<rootDir>/../../../packages/$1/src/index.ts",
    "^@scure/base$": "<rootDir>/mocks/scure-base.ts",
    "^@otplib/plugin-crypto-noble$": "<rootDir>/mocks/otplib-crypto.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "setupFiles": ["./setup-e2e-env.ts", "./setup-env.ts"],
  "collectCoverageFrom": [
    "../src/**/*.ts",
    "!../src/main.ts",
    "!../src/**/*.module.ts"
  ],
  "coverageDirectory": "../coverage-e2e",
  "testTimeout": 30000,
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/dist/"
  ],
  "maxWorkers": 1
}
