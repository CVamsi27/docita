DATABASE_URL="postgresql://docita:docita@localhost:5434/docita?options=-c%20TimeZone%3DUTC"
# Staging/prod: use docita_app role URL before RLS_ENABLED=true (docs/compliance/RLS_ROLLOUT.md)
RLS_ENABLED=false
PORT=3001
NODE_ENV="production"
CPU_COUNT=2
LOG_LEVEL="info"

APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001/api/v1"
# Legacy aliases (deprecated; still accepted as fallback until the rollout
# completes): NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_API_URL
# Partner self-service portal URL. Leave blank to default to
# `${FRONTEND_URL}/partner`.
PARTNER_PORTAL_URL=""
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

JWT_SECRET=""
JWT_EXPIRATION="15m"
ENCRYPTION_KEY=""
ENCRYPTION_KEY_V2=""
ENCRYPTION_KEY_V3=""
ENCRYPTION_KEY_V4=""
ENCRYPTION_KEY_V5=""

SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_PROFILING=false
APP_VERSION="1.0.0"
API_LOG_MODE="access-and-errors"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
ZEPTOMAIL_SENDMAIL_TOKEN=""
ZEPTOMAIL_API_URL="https://api.zeptomail.in/v1.1/email"
# Secret the ZeptoMail webhook sends in its Authorization header (configure in ZeptoMail webhook settings).
ZEPTOMAIL_WEBHOOK_SECRET=""
EMAIL_FROM="Docita <notifications@docita.work>"

WHATSAPP_PRODUCTION_MODE=false
# Public booking: returning-patient OTP is sent as a plain-text WhatsApp message (same Meta credentials as other automation).
# Production Meta policies may require an approved template; align with your WhatsApp Business configuration.
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_BUSINESS_ACCOUNT_ID=""

AI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo"
AI_REQUEST_TIMEOUT=5000
AI_CACHE_ENABLED=true
AI_CACHE_TTL=86400

SMS_API_KEY=""
SMS_SENDER_ID=""
# Optional external doctor-license verification provider
DOCTOR_VERIFICATION_API_URL=""
DOCTOR_VERIFICATION_API_KEY=""

# ABDM (Ayushman Bharat Digital Mission) — leave unset to keep gateway in NOT_CONFIGURED state
ABDM_BASE_URL=""
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
# Shared secret expected in x-docita-abdm-secret for ABDM callback replay-protected ingestion.
ABDM_CALLBACK_SECRET=""
# ABHA M1 verification host (defaults to abhasbx.abdm.gov.in on sandbox / abha.abdm.gov.in on prod).
ABDM_ABHA_BASE_URL=""
# RSA public key (PEM or base64) for encrypting mobile/OTP. Sandbox key is bundled as a fallback.
ABDM_ABHA_PUBLIC_KEY=""

# DPDP grievance / DPO contact (defaults to support@docita.work when empty)
GRIEVANCE_CONTACT_EMAIL=""

# Medical code catalog source for CPT/HCPCS:
# - nlm_hcpcs (default): public HCPCS API + local fallback
# - licensed: licensed CPT vendor API (configure vars below)
CPT_CATALOG_SOURCE="nlm_hcpcs"
CPT_LICENSED_API_URL=""
CPT_LICENSED_API_KEY=""
CPT_LICENSED_SEARCH_PATH="/search"
CPT_LICENSED_SYNC_PATH="/codes"

# Storage provider (Cloudflare R2 for production document storage)
# For production set STORAGE_PROVIDER=r2 and configure all R2_* values.
STORAGE_PROVIDER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="docita-storage"
# Note: Next.js ISR cache bucket uses Wrangler binding
# NEXT_INC_CACHE_R2_BUCKET -> docita-cache (no API .env var needed)

# Optional script override
DOCITA_API_BASE="http://localhost:3001"

SECRETS_PROVIDER="env"
ANALYTICS_CACHE_TTL=300
PAYMENT_LINK_TTL_MINUTES=15
BULK_IMPORT_MAX_FILE_SIZE=52428800
BULK_IMPORT_MAX_ROWS=100000
BULK_IMPORT_RATE_LIMIT_INTERVAL=300
SLOW_QUERY_THRESHOLD_MS=1000
REQUEST_TIMEOUT_MS=30000

# Background job queue backend
# "memory" (default): in-process queue, jobs lost on restart — suitable for dev and Phase 4
# "postgres": durable queue backed by QueueJob table — required for the separate worker process (Phase 5)
QUEUE_BACKEND="memory"

# Scheduler toggle used for the API/worker split.
# Keep true for local development; production API should set false once the worker is healthy.
ENABLE_SCHEDULERS="true"

# Worker process entrypoint (used by the Dockerfile CMD)
# "main" (default): boots the full API with HTTP server
# "worker": boots the queue-consumer worker without HTTP
WORKER_ENTRYPOINT="main"

# Cloudflare Turnstile (verify tokens from /public/booking). Optional in dev when unset (API skips enforcement).
TURNSTILE_SECRET_KEY=""

# ─── Database Control (internal portal) ────────────────────────────────────
# Master switch. Defaults to false; must be explicitly enabled per env.
DATABASE_CONTROL_ENABLED="false"
# Comma-separated list of NODE_ENV values the control is allowed to run in.
DATABASE_CONTROL_ALLOWED_ENV="production,staging"
# AWS region of the target RDS instance.
DATABASE_CONTROL_AWS_REGION="ap-south-1"
# RDS DB instance identifier (NOT the endpoint hostname).
DATABASE_CONTROL_RDS_INSTANCE_ID="docita-db"
# Destination address for action notifications. Required when DATABASE_CONTROL_ENABLED=true.
DATABASE_CONTROL_ALERT_EMAIL="admin@docita.work"
# Block Stop/Delete/Restore while a `Deploy Production` GitHub Actions run is in flight.
DATABASE_CONTROL_DEPLOY_GUARD="true"
# Cooldown (seconds) after Stop/Delete/Snapshot/Restore to block the same action from firing twice.
DATABASE_CONTROL_COOLDOWN_SECONDS="60"

# AWS credentials (long-lived access keys for now; migrate to IAM role on Fly later).
# IAM user must be scoped to arn:aws:rds:ap-south-1:*:db:docita-db with the actions
# listed in docs/architecture/DATABASE_CONTROL_PLAN.md §1.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
