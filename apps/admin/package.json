{
  "name": "@docita/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build --webpack",
    "build:cloudflare": "DOCITA_CLOUDFLARE=1 turbo build --filter=@workspace/ui --filter=@workspace/types --filter=@workspace/utils --filter=@workspace/data-access && DOCITA_CLOUDFLARE=1 opennextjs-cloudflare build && node ../../scripts/ensure-opennext-prefetch-manifest-patch.mjs --app=admin && node ../../scripts/check-worker-size.mjs .open-next/worker.js @docita/admin",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "audit:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.47.0",
    "@tanstack/react-query": "^5.90.10",
    "@workspace/data-access": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.66.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-playwright": "^2.2.2",
    "@workspace/eslint-config": "workspace:^",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "typescript": "^5",
    "vite": "^6.4.1",
    "vitest": "^4.0.16",
    "wrangler": "^4.71.0"
  }
}
