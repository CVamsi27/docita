{
  "name": "@docita/internal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/clean-next.mjs --if-production && next dev --port 3002",
    "build": "node ./scripts/clean-next.mjs && next build --webpack",
    "build:cloudflare": "pnpm run build:cloudflare:production",
    "build:cloudflare:base": "DOCITA_CLOUDFLARE=1 pnpm -w run build:web-workspace-deps && node -e \"require('fs').rmSync('.open-next', { recursive: true, force: true })\" && DOCITA_CLOUDFLARE=1 opennextjs-cloudflare build && node ../../scripts/deploy/ensure-opennext-prefetch-manifest-patch.mjs --app=internal && node ../../scripts/checks/check-worker-size.mjs .open-next/worker.js @docita/internal",
    "build:cloudflare:production": "DOCITA_ENV=production APP_URL=https://internal.docita.work API_URL=https://api.docita.work/api/v1 API_PROXY_TARGET=https://api.docita.work NEXT_PUBLIC_API_URL=/api/v1 pnpm run build:cloudflare:base",
    "build:cloudflare:staging": "DOCITA_ENV=staging APP_URL=https://staging-internal.docita.work API_URL=https://staging-api.docita.work/api/v1 API_PROXY_TARGET=https://staging-api.docita.work NEXT_PUBLIC_API_URL=/api/v1 pnpm run build:cloudflare:base",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "deploy:cloudflare:staging": "pnpm run build:cloudflare:staging && wrangler deploy --env staging",
    "deploy:cloudflare:production": "pnpm run build:cloudflare:production && wrangler deploy --env production",
    "start": "next start",
    "lint": "eslint",
    "check-types": "node ./scripts/clean-next.mjs --if-production && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "audit:accessibility": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/accessibility.spec.ts",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.1",
    "@fontsource/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@sentry/nextjs": "^10.47.0",
    "@tanstack/react-query": "^5.90.10",
    "@workspace/data-access": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "lucide-react": "^0.475.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.66.1",
    "react-phone-number-input": "^3.4.14",
    "sonner": "^2.0.7",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@opennextjs/cloudflare": "^1.17.1",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@workspace/eslint-config": "workspace:^",
    "axe-playwright": "^2.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "typescript": "5.7.3",
    "vite": "^6.4.2",
    "vitest": "^4.0.16",
    "webpack-bundle-analyzer": "^4.10.1",
    "wrangler": "^4.90.0"
  }
}
