# Worker process environment
# The worker shares apps/api/src/ and validates env via the same EnvSchema.
# Copy this to apps/worker/.env and fill in the required values.
# In local dev the worker is not run separately — it is embedded in the API process.
# Use this file only when running the worker as a standalone process (production or testing).

# --- Required ---
DATABASE_URL="postgresql://docita:docita@localhost:5434/docita?options=-c%20TimeZone%3DUTC"
ENCRYPTION_KEY=""           # Exactly 64 hex chars: openssl rand -hex 32

# --- Worker identity ---
WORKER_ENTRYPOINT="worker"  # Must be "worker" for the standalone consumer process
QUEUE_BACKEND="postgres"    # Must be "postgres" for durable cross-process queuing
ENABLE_SCHEDULERS="true"    # Worker owns scheduled jobs in production

# --- URLs (must match API deployment) ---
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# --- Storage (set r2 + R2_* in production) ---
STORAGE_PROVIDER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="docita-storage"

# --- Notifications (optional; worker sends emails and WhatsApp messages) ---
ZEPTOMAIL_SENDMAIL_TOKEN=""
ZEPTOMAIL_API_URL="https://api.zeptomail.in/v1.1/email"
EMAIL_FROM="Docita <notifications@docita.work>"
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PRODUCTION_MODE=false

# --- Observability ---
SENTRY_DSN=""
APP_VERSION="1.0.0"
LOG_LEVEL="info"
NODE_ENV="production"
