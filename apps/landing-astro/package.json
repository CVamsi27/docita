{
  "name": "@docita/landing-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3004",
    "build": "astro build",
    "build:cloudflare": "DOCITA_CLOUDFLARE=1 turbo build --filter=@workspace/ui && astro build",
    "preview:cloudflare": "astro build && wrangler dev",
    "deploy:cloudflare": "astro build && wrangler deploy",
    "lint": "eslint src e2e astro.config.mjs playwright.config.ts --ext .ts,.tsx,.js,.mjs",
    "check-types": "astro check",
    "audit:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts"
  },
  "dependencies": {
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.475.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/react": "^4.4.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@workspace/eslint-config": "workspace:^",
    "astro": "^5.8.1",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.71.0"
  }
}
