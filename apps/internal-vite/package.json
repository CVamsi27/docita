{
  "name": "@docita/internal-vite",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3002",
    "prebuild": "pnpm -w run build:web-workspace-deps",
    "build": "vite build",
    "build:cloudflare": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy --minify",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test e2e",
    "audit:accessibility": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/accessibility.spec.ts",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts"
  },
  "dependencies": {
    "@sentry/react": "^10.47.0",
    "@tanstack/react-query": "^5.90.10",
    "@workspace/data-access": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "hono": "^4.7.7",
    "lucide-react": "^0.475.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "^2.0.5",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-playwright": "^2.0.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^27.4.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.90.0"
  }
}
