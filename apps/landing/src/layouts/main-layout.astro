---
import "@workspace/ui/globals.css";
import "@/styles/global.css";

import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import { StickyCta } from "@/components/sections/sticky-cta";
import { getAppBaseUrl } from "@/lib/get-app-base-url";
import { SUPPORT_EMAIL } from "@workspace/types";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Docita - Clinic Management Software",
  description = "Docita helps clinics and hospitals move from paper files and Excel into appointments, prescriptions, billing, records, and patient communication in one reliable workflow",
  canonicalPath = "/",
  noIndex = false,
  structuredData,
} = Astro.props;

const siteUrl = "https://docita.work";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const appUrl = getAppBaseUrl();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Docita",
  applicationCategory: "HealthApplication",
  operatingSystem: "Web",
  url: siteUrl,
  description,
  offers: {
    "@type": "Offer",
    price: "499",
    priceCurrency: "INR",
    description: "Monthly clinic and hospital software plans with guided setup available",
  },
  creator: {
    "@type": "Organization",
    name: "Docita",
    url: siteUrl,
    email: SUPPORT_EMAIL,
  },
};
const structuredDataItems =
  structuredData === undefined
    ? []
    : Array.isArray(structuredData)
      ? structuredData
      : [structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito:wght@500;600;700&display=swap"
    />
    <script is:inline>
      (() => {
        const storageKey = "docita-theme";
        const stored = localStorage.getItem(storageKey);
        const theme = stored === "dark" || stored === "light"
          ? stored
          : "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/branding/Round_Logo-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/branding/Round_Logo-512.png" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Docita" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://docita.work/branding/Dark-background.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Docita - Clinic & Hospital Management Software" />
    <meta property="og:locale" content="en_IN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@docita_work" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://docita.work/branding/Dark-background.png" />

    {noIndex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {structuredDataItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8M9WEK4LEE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8M9WEK4LEE');
    </script>
  </head>
  <body class="landing-surface min-h-screen bg-background font-sans text-foreground antialiased">
    <SiteHeader />
    <main class="pt-[calc(4rem+env(safe-area-inset-top,0px))]">
      <slot />
    </main>
    <SiteFooter />
    <StickyCta appUrl={appUrl} client:load />
  </body>
</html>
