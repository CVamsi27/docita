---
import MainLayout from "@/layouts/main-layout.astro";
import { PricingSection } from "@/components/pricing-section";
import { AiAutomationSection } from "@/components/sections/ai-automation-section";
import { CtaBottomSection } from "@/components/sections/cta-bottom-section";
import { FaqSection } from "@/components/sections/faq-section";
import { HeroSection } from "@/components/sections/hero-section";
import { HowItWorksSection } from "@/components/sections/how-it-works-section";
import { MigrationSection } from "@/components/sections/migration-section";
import { OutcomesStripSection } from "@/components/sections/outcomes-strip-section";
import { ResourceLinksSection } from "@/components/sections/resource-links-section";
import { SignatureCapabilitiesSection } from "@/components/sections/signature-capabilities-section";
import { StatsSection } from "@/components/sections/stats-section";
import { TrustSecuritySection } from "@/components/sections/trust-security-section";
import { WorkflowCompareSection } from "@/components/sections/workflow-compare-section";
import { getAppBaseUrl } from "@/lib/public-api";
import { fetchPlatformStats } from "@/lib/landing-data";

const appUrl = getAppBaseUrl();
const platformStats = await fetchPlatformStats(Astro.url.origin);
---

<!--
  Scroll arc: hook (hero) → platform proof (stats) → product surface (signature) → operating facts (outcomes) → rollout (how it works) → control surface (compare) → migration & AI → resources → trust → pricing → FAQ → CTA.
-->
<MainLayout
  canonicalPath="/"
  title="Docita — OPD rhythm: queue, chart, bill, WhatsApp | Guided setup"
  description="One operating rhythm for Indian private clinics—tokens, EMR, prescriptions, billing, and WhatsApp follow-ups in a single layer, with migration support and guided setup."
>
  <HeroSection appUrl={appUrl} client:idle />
  <StatsSection stats={platformStats} />
  <SignatureCapabilitiesSection appUrl={appUrl} client:visible />
  <OutcomesStripSection />
  <HowItWorksSection client:visible />
  <WorkflowCompareSection client:visible />
  <MigrationSection tone="soft" client:visible />
  <AiAutomationSection tone="muted" client:visible />
  <ResourceLinksSection client:visible />
  <TrustSecuritySection client:visible />
  <PricingSection appUrl={appUrl} client:visible />
  <FaqSection />
  <CtaBottomSection client:visible />
</MainLayout>
