---
import MainLayout from "@/layouts/main-layout.astro";
import { PricingSection } from "@/components/pricing-section";
import { AiAutomationSection } from "@/components/sections/ai-automation-section";
import { AnalyticsSection } from "@/components/sections/analytics-section";
import { ClinicSetupSection } from "@/components/sections/clinic-setup-section";
import { CtaBottomSection } from "@/components/sections/cta-bottom-section";
import { FaqSection } from "@/components/sections/faq-section";
import { FeaturesGridSection } from "@/components/sections/features-grid-section";
import { HeroSection } from "@/components/sections/hero-section";
import { HowItWorksSection } from "@/components/sections/how-it-works-section";
import { LabInventorySection } from "@/components/sections/lab-inventory-section";
import { MigrationSection } from "@/components/sections/migration-section";
import { MedicalCodingSection } from "@/components/sections/medical-coding-section";
import { ProductTourSection } from "@/components/sections/product-tour-section";
import { QueueSection } from "@/components/sections/queue-section";
import { ResourceLinksSection } from "@/components/sections/resource-links-section";
import { SpecialtiesSection } from "@/components/sections/specialties-section";
import { StatsSection } from "@/components/sections/stats-section";
import { TrustSecuritySection } from "@/components/sections/trust-security-section";
import { ValuePropsSection } from "@/components/sections/value-props-section";
import { WhatsappSection } from "@/components/sections/whatsapp-section";
import { getAppBaseUrl } from "@/lib/public-api";
import { fetchPlatformStats } from "@/lib/landing-data";

const appUrl = getAppBaseUrl();
const platformStats = await fetchPlatformStats(Astro.url.origin);
---

<MainLayout
  canonicalPath="/"
  title="Docita - Clinic Management Software for Indian Clinics | 1-Day Setup"
  description="Docita helps Indian clinics move from paper files and Excel into appointments, prescriptions, billing, records, and WhatsApp communication with guided clinic setup"
>
  <HeroSection appUrl={appUrl} />
  <StatsSection stats={platformStats} />
  <ClinicSetupSection />
  <MigrationSection />
  <HowItWorksSection />
  <ValuePropsSection />
  <ProductTourSection appUrl={appUrl} />
  <QueueSection />
  <MedicalCodingSection />
  <LabInventorySection />
  <SpecialtiesSection />
  <AnalyticsSection />
  <AiAutomationSection />
  <WhatsappSection />
  <FeaturesGridSection />
  <ResourceLinksSection />
  <TrustSecuritySection />
  <PricingSection appUrl={appUrl} />
  <FaqSection />
  <CtaBottomSection />
</MainLayout>
