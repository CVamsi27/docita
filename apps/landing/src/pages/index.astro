---
import MainLayout from "@/layouts/main-layout.astro";
import { ClinicRhythmSection } from "@/components/sections/clinic-rhythm-section";
import { DifferentiatorsSection } from "@/components/sections/differentiators-section";
import { FaqCtaSection } from "@/components/sections/faq-cta-section";
import { HeroSection } from "@/components/sections/hero-section";
import { PricingSection } from "@/components/pricing-section";
import { ProofStripSection } from "@/components/sections/proof-strip-section";
import { RolloutSection } from "@/components/sections/rollout-section";
import { SurfaceMapSection } from "@/components/sections/surface-map-section";
import { WorkflowCompareSection } from "@/components/sections/workflow-compare-section";
import { getAppBaseUrl } from "@/lib/public-api";
import { fetchPlatformStats } from "@/lib/landing-data";

const appUrl = getAppBaseUrl();
const platformStats = await fetchPlatformStats(Astro.url.origin);
---

<!--
  R2 arc: hero (live product) -> proof -> day rhythm (signature) ->
  surface map (breadth) -> compare -> rollout -> differentiators ->
  pricing -> FAQ + CTA.
-->
<MainLayout
  canonicalPath="/"
  title="Docita - One rhythm for your whole OPD floor | Patient portal, EMR, billing, WhatsApp"
  description="One operating layer for Indian private clinics: queue, EMR, prescriptions, billing, WhatsApp, lab tests, inventory, analytics, and a real patient portal. Two-week rollout."
>
  <HeroSection appUrl={appUrl} client:idle />
  <ProofStripSection stats={platformStats} />
  <ClinicRhythmSection client:visible />
  <SurfaceMapSection client:visible />
  <WorkflowCompareSection client:visible />
  <RolloutSection client:visible />
  <DifferentiatorsSection client:visible />
  <section
    class="r2-section border-y border-border/50 bg-muted/25"
    aria-labelledby="front-desk-landing-teaser-heading"
  >
    <div class="ui-page-shell py-8 sm:py-10">
      <h2
        id="front-desk-landing-teaser-heading"
        class="text-base font-semibold tracking-tight text-foreground"
      >
        Front desk workspace (not a separate paid tier)
      </h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">
        Same subscription plans as below. This path keeps scheduling, queue,
        patients, and invoicing while turning off in-app consultation and
        prescription authoring for your facility.
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
        <a
          class="font-medium text-primary underline-offset-4 hover:underline"
          href={`${appUrl}/onboarding?workspace=front_desk`}
        >
          Start front desk onboarding
        </a>
        <span class="text-muted-foreground" aria-hidden="true">|</span>
        <a
          class="font-medium text-primary underline-offset-4 hover:underline"
          href="#front-desk-workspace"
        >
          Details in pricing
        </a>
      </p>
    </div>
  </section>
  <PricingSection appUrl={appUrl} client:idle />
  <FaqCtaSection appUrl={appUrl} client:visible />
</MainLayout>
