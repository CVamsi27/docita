---
import MainLayout from "@/layouts/main-layout.astro";
import { ClinicRhythmSection } from "@/components/sections/clinic-rhythm-section";
import { ClinicTypesSection } from "@/components/sections/clinic-types-section";
import { ComparisonStripSection } from "@/components/sections/comparison-strip-section";
import { DifferentiatorsSection } from "@/components/sections/differentiators-section";
import { FaqCtaSection } from "@/components/sections/faq-cta-section";
import { HeroSection } from "@/components/sections/hero-section";
import { PricingSection } from "@/components/pricing-section";
import { ProductScreenshotsSection } from "@/components/sections/product-screenshots-section";
import { ProofStripSection } from "@/components/sections/proof-strip-section";
import { RolloutSection } from "@/components/sections/rollout-section";
import { SurfaceMapSection } from "@/components/sections/surface-map-section";
import { WorkflowCompareSection } from "@/components/sections/workflow-compare-section";
import { getAppBaseUrl } from "@/lib/get-app-base-url";
import { fetchPlatformStats } from "@/lib/landing-data";
import { buildFaqPageStructuredData } from "@/lib/faqs";

const appUrl = getAppBaseUrl();
const platformStats = await fetchPlatformStats(Astro.url.origin);
const siteUrl = "https://docita.work";
const faqStructuredData = buildFaqPageStructuredData(`${siteUrl}/`);
---

<!--
  R2 arc: hero (live product) -> proof -> day rhythm (signature) ->
  surface map (breadth) -> product screenshots (real captures) ->
  clinic types (audience) -> compare (control) -> rollout -> differentiators ->
  comparison strip (factual side-by-side) -> pricing (with plan picker) ->
  FAQ + CTA.
-->
<MainLayout
  canonicalPath="/"
  title="Docita - Clinic & Hospital Management Software"
  description="One operating layer for Indian clinics and hospitals: queue, EMR, prescriptions, billing, WhatsApp, lab tests, inventory, analytics, and a real patient portal. Two-week rollout."
  structuredData={faqStructuredData}
>
  <HeroSection appUrl={appUrl} client:idle />
  <ProofStripSection stats={platformStats} />
  <ClinicRhythmSection client:visible />
  <SurfaceMapSection client:visible />
  <ProductScreenshotsSection client:visible />
  <ClinicTypesSection client:visible />
  <WorkflowCompareSection client:visible />
  <RolloutSection client:visible />
  <DifferentiatorsSection client:visible />
  <ComparisonStripSection client:visible />
  <PricingSection appUrl={appUrl} client:idle />
  <FaqCtaSection appUrl={appUrl} />
</MainLayout>
