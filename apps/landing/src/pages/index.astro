---
import MainLayout from "@/layouts/main-layout.astro";
import { EditorialHomepage } from "@/components/sections/editorial-homepage";
import { getAppBaseUrl } from "@/lib/get-app-base-url";
const appUrl = getAppBaseUrl();
---
<MainLayout editorial canonicalPath="/" title="Docita - Clinic & Hospital Management Software" description="A calmer clinic day. Appointments, consultations, prescriptions and billing connected from reception to follow-up for Indian clinics and hospitals.">
  <EditorialHomepage appUrl={appUrl} />
</MainLayout>

<script is:inline>
  // Preserve bookmarked sections from the previous long homepage.
  const productSections = new Set(["#rhythm", "#surface-map", "#product-screenshots", "#clinic-types", "#workflow-compare", "#rollout", "#faq"]);
  if (productSections.has(window.location.hash)) {
    window.location.replace(`/product${window.location.hash}`);
  }
</script>
