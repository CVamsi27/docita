---
import MainLayout from "@/layouts/main-layout.astro";
---

<MainLayout
  title="Page Not Found | Docita"
  description="The page you requested could not be found"
  noIndex={true}
>
  <section class="px-6 py-24">
    <div class="container mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">404</p>
      <h1 class="mt-3 text-4xl font-bold tracking-normal">Page not found</h1>
      <p class="mt-4 text-base text-muted-foreground">
        The link may be outdated or the page may have moved.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Back to Home
      </a>
    </div>
  </section>
</MainLayout>
