---
import MainLayout from "@/layouts/main-layout.astro";
import { ContactInquiryForm } from "@/components/contact-inquiry-form";

const faqs = [
  {
    question: "How do I get started with Docita?",
    answer:
      "Book a guided setup, share your current patient list or workflow, and we will scope the first clinic workflow to move live. Smaller practices can begin with prescriptions, billing, and WhatsApp follow-up first.",
  },
  {
    question: "Is patient data secure?",
    answer:
      "Yes. Docita uses layered security controls such as encryption, role-based access, audit logging, and India-hosted backend infrastructure.",
  },
  {
    question: "Can we migrate from another system?",
    answer:
      "Yes. We support structured import paths today for spreadsheets and can help clinics plan larger migrations without disrupting day-to-day operations.",
  },
  {
    question: "What support options are available?",
    answer:
      "All plans include support. Higher tiers include priority support and stronger success coverage.",
  },
];
---

<MainLayout
  canonicalPath="/contact"
  title="Contact Docita"
  description="Reach the Docita team for clinic setup, product demos, onboarding help, pricing guidance, and support"
>
  <section class="px-6 py-14">
    <div class="ui-page-shell">
      <div class="mb-10 text-center">
        <h1 class="ui-page-title text-balance text-foreground">Contact Us</h1>
        <p class="mx-auto mt-3 max-w-2xl text-base text-muted-foreground">
          Reach out for paid clinic setup, product demos, migration planning,
          rollout help, and practical guidance on getting your clinic live
          quickly.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
        <aside class="space-y-6">
          <article class="landing-surface-panel rounded-[var(--radius)] border border-border/70 p-5">
            <h2 class="ui-section-title text-[var(--fs-2xl)]">Email Channels</h2>
            <div class="mt-4 space-y-3 ui-helper-text">
              <p>
                <strong class="text-foreground">CEO, Founder:</strong>
                <a class="ml-2 text-primary hover:underline" href="mailto:vkc@docita.work">vkc@docita.work</a>
              </p>
              <p>
                <strong class="text-foreground">Government, paperwork:</strong>
                <a class="ml-2 text-primary hover:underline" href="mailto:admin@docita.work">admin@docita.work</a>
              </p>
              <p>
                <strong class="text-foreground">Billing & invoices:</strong>
                <a class="ml-2 text-primary hover:underline" href="mailto:billing@docita.work">billing@docita.work</a>
              </p>
              <p>
                <strong class="text-foreground">Customer support:</strong>
                <a class="ml-2 text-primary hover:underline" href="mailto:support@docita.work">support@docita.work</a>
              </p>
            </div>
          </article>

          <article class="landing-surface-panel rounded-[var(--radius)] border border-border/70 p-5">
            <h2 class="ui-section-title text-[var(--fs-2xl)]">Support Hours</h2>
            <div class="mt-4 space-y-2 ui-helper-text">
              <p><strong class="text-foreground">Mon - Fri:</strong> 9:00 AM - 6:00 PM IST</p>
              <p><strong class="text-foreground">Saturday:</strong> 10:00 AM - 2:00 PM IST</p>
              <p><strong class="text-foreground">Sunday:</strong> Closed</p>
            </div>
          </article>

          <article class="landing-surface-panel rounded-[var(--radius)] border border-border/70 p-5">
            <h2 class="ui-section-title text-[var(--fs-2xl)]">Quick Links</h2>
            <ul class="mt-4 space-y-2 ui-helper-text">
              <li>
                <a class="transition-colors hover:text-foreground" href="mailto:support@docita.work?subject=Clinic%20Setup%20Request">
                  Request Clinic Setup
                </a>
              </li>
              <li>
                <a class="transition-colors hover:text-foreground" href="mailto:support@docita.work?subject=Technical%20Support">
                  Technical Support
                </a>
              </li>
              <li>
                <a class="transition-colors hover:text-foreground" href="mailto:admin@docita.work?subject=Government%20or%20Paperwork%20Inquiry">
                  Government & Paperwork
                </a>
              </li>
            </ul>
          </article>

          <article class="landing-surface-panel rounded-[var(--radius)] border border-border/70 p-5">
            <h2 class="ui-section-title text-[var(--fs-2xl)]">Address</h2>
            <div class="mt-4 space-y-1 ui-helper-text">
              <p class="font-medium text-foreground">CHANDALURI VAMSI KRISHNA</p>
              <p>Sole Proprietor, Docita</p>
              <p>GSTIN: 36CJPPC6222C1ZI</p>
              <p>Aparna Cyberscape, Nalagandla</p>
              <p>Hyderabad, Telangana 500019</p>
              <p>India</p>
            </div>
          </article>
        </aside>

        <div>
          <ContactInquiryForm />
        </div>
      </div>

      <div class="mt-16">
        <h2 class="ui-section-title text-center text-[var(--fs-3xl)]">Frequently Asked Questions</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {faqs.map((faq) => (
            <article class="landing-surface-panel rounded-[var(--radius)] border border-border/70 p-5">
              <h3 class="ui-section-title text-[var(--fs-lg)]">{faq.question}</h3>
              <p class="mt-2 ui-helper-text">{faq.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  const root = document.querySelector("[data-contact-inquiry-root]");

  if (root) {
    const form = root.querySelector("[data-contact-form]");
    const submitButton = root.querySelector("[data-contact-submit]");
    const submitLabel = root.querySelector("[data-contact-submit-label]");
    const successView = root.querySelector("[data-contact-success]");
    const submitError = root.querySelector("[data-contact-submit-error]");
    const resetButton = root.querySelector("[data-contact-reset]");
    const fields = ["name", "email", "clinic", "message"];

    if (form && submitButton && submitLabel && successView && submitError) {
      const errorNodes = new Map();

      for (const field of fields) {
        const errorNode = root.querySelector(`[data-contact-error="${field}"]`);
        if (errorNode) {
          errorNodes.set(field, errorNode);
        }
      }

      const getField = (field) => form.querySelector(`[name="${field}"]`);

      const clearError = (field) => {
        const node = errorNodes.get(field);
        const control = getField(field);

        if (node) {
          node.hidden = true;
          node.textContent = "";
        }

        if (control) {
          control.setAttribute("aria-invalid", "false");
        }
      };

      const showError = (field, message) => {
        const node = errorNodes.get(field);
        const control = getField(field);

        if (node) {
          node.textContent = message;
          node.hidden = false;
        }

        if (control) {
          control.setAttribute("aria-invalid", "true");
        }
      };

      const clearSubmitError = () => {
        submitError.textContent = "";
        submitError.classList.add("hidden");
      };

      const showSubmitError = (message) => {
        submitError.textContent = message;
        submitError.classList.remove("hidden");
      };

      const validate = () => {
        let isValid = true;

        for (const field of fields) {
          clearError(field);
        }
        clearSubmitError();

        const formData = new FormData(form);
        const name = String(formData.get("name") ?? "").trim();
        const email = String(formData.get("email") ?? "").trim();
        const clinic = String(formData.get("clinic") ?? "").trim();
        const message = String(formData.get("message") ?? "").trim();

        if (!name) {
          showError("name", "Enter your name");
          isValid = false;
        }

        if (!email) {
          showError("email", "Enter your email address");
          isValid = false;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError("email", "Please enter a valid email address");
          isValid = false;
        }

        if (!clinic) {
          showError("clinic", "Enter your facility name");
          isValid = false;
        }

        if (!message) {
          showError("message", "Enter your message");
          isValid = false;
        }

        return isValid;
      };

      const setBusy = (busy) => {
        submitButton.disabled = busy;
        submitLabel.textContent = busy ? "Sending..." : "Request setup";
      };

      const showSuccess = () => {
        form.hidden = true;
        successView.hidden = false;
      };

      const resetForm = () => {
        form.reset();
        form.hidden = false;
        successView.hidden = true;
        clearSubmitError();

        for (const field of fields) {
          clearError(field);
        }

        setBusy(false);
      };

      for (const field of fields) {
        const control = getField(field);
        control?.addEventListener("input", () => clearError(field));
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!validate()) {
          return;
        }

        setBusy(true);

        try {
          const payload = new FormData(form);
          const response = await fetch("/api/v1/contact/inquiry", {
            method: "POST",
            credentials: "include",
            headers: {
              "Content-Type": "application/json",
              "X-XSRF-TOKEN": getCookie("XSRF-TOKEN") ?? "",
            },
            body: JSON.stringify({
              name: String(payload.get("name") ?? "").trim(),
              email: String(payload.get("email") ?? "").trim(),
              clinic: String(payload.get("clinic") ?? "").trim(),
              message: String(payload.get("message") ?? "").trim(),
            }),
          });

          if (!response.ok) {
            throw new Error("request failed");
          }

          showSuccess();
        } catch {
          showSubmitError(
            "We could not send your message right now. Please try again in a few minutes.",
          );
        } finally {
          setBusy(false);
        }
      });

      resetButton?.addEventListener("click", resetForm);
    }
  }

  function getCookie(name) {
    const row = document.cookie
      .split(";")
      .map((value) => value.trim())
      .find((value) => value.startsWith(`${name}=`));

    return row ? decodeURIComponent(row.slice(name.length + 1)) : null;
  }
</script>
