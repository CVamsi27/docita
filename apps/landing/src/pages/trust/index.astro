---
import MainLayout from "@/layouts/main-layout.astro";

const controls = [
  "Encrypted transport and storage for sensitive data",
  "Role-based access for doctors, reception, and admins",
  "Audit logging for sensitive operational workflows",
  "Consent-aware communication and privacy controls",
  "Data export paths to avoid lock-in",
];

const nonClaims = [
  "We do not advertise unsupported ISO 27001 or SOC 2 claims here.",
  "We do not use broad diagnosis-led AI claims as a trust shortcut.",
  "Customers remain responsible for the policies and notices required in their own practice.",
];
---

<MainLayout
  canonicalPath="/trust"
  title="Trust, Hosting, and Privacy Posture | Docita"
  description="Current hosting, India data residency, and privacy-focused controls for Docita."
>
  <section class="px-6 py-16">
    <div class="ui-page-shell">
      <div class="max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-primary">
          Trust and hosting
        </p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          The trust details we can actually stand behind today
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-muted-foreground">
          Docita is choosing explicit, verifiable trust language over generic
          badge-heavy marketing. This page summarizes the current deployment and
          privacy posture that supports the product as of now.
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_0.95fr]">
        <article class="rounded-3xl border border-border/70 bg-background p-8">
          <h2 class="text-2xl font-semibold">Current hosting posture</h2>
          <ul class="mt-4 list-disc space-y-2 pl-6 text-sm text-muted-foreground">
            <li>Backend API and worker infrastructure run in the Mumbai region.</li>
            <li>AWS RDS PostgreSQL is configured in <code>ap-south-1</code> (Mumbai).</li>
            <li>Cloudflare is used for the frontend surface and object storage via R2.</li>
            <li>Deployment documentation states that backend systems are co-located in Mumbai for Indian data residency considerations.</li>
          </ul>

          <h3 class="mt-8 text-lg font-semibold">Operational controls</h3>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-sm text-muted-foreground">
            {controls.map((control) => (
              <li>{control}</li>
            ))}
          </ul>
        </article>

        <article class="rounded-3xl border border-primary/20 bg-primary/5 p-8">
          <h2 class="text-2xl font-semibold">Important non-claims</h2>
          <ul class="mt-4 list-disc space-y-2 pl-6 text-sm text-muted-foreground">
            {nonClaims.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <h3 class="mt-8 text-lg font-semibold">Where to learn more</h3>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-sm text-muted-foreground">
            <li><a class="text-primary hover:underline" href="/privacy">Privacy policy</a></li>
            <li><a class="text-primary hover:underline" href="/contact">Contact the team</a></li>
            <li><a class="text-primary hover:underline" href="/paper-to-cloud">Migration rollout</a></li>
          </ul>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
            >
              Ask about rollout
            </a>
            <a
              href="/privacy"
              class="inline-flex items-center justify-center rounded-xl border bg-background px-4 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
            >
              Review privacy policy
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>
</MainLayout>
