---
import { DocitaLogo } from "@workspace/ui/components/indicators/docita-logo";

interface Props {
  title: string;
  description: string;
  downloadHref: string;
  downloadLabel: string;
  /** Short artifact line shown above the title, e.g. "RX · 12 Apr · Dr. Sharma". */
  recordLine?: string;
  /** Accent for the slip band. One of "primary" | "info" | "success". */
  accent?: "primary" | "info" | "success";
}

const { title, description, downloadHref, downloadLabel, recordLine, accent = "primary" } =
  Astro.props;

const accentClass =
  accent === "info"
    ? "is-info"
    : accent === "success"
      ? "is-success"
      : "";
---

<main class="pdd-main">
  <article class={`pdd-slip${accentClass ? ` ${accentClass}` : ""}`}>
    <div class="pdd-slip-band" aria-hidden="true" />
    <header class="pdd-slip-head">
      {recordLine ? (
        <p class="pdd-record-line" aria-hidden="true">
          {recordLine}
        </p>
      ) : null}
      <h1 class="pdd-title">{title}</h1>
      <p class="pdd-description">{description}</p>
    </header>

    <div class="pdd-slip-body" aria-hidden="true">
      <span class="pdd-slip-dot" />
      <span class="pdd-slip-rule" />
      <span class="pdd-slip-dot" />
    </div>

    <a href={downloadHref} class="pdd-tear-tab" download>
      <span class="pdd-tear-tab-label">{downloadLabel}</span>
      <svg
        class="pdd-tear-tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
    </a>

    <p class="pdd-note">This link is for you only. No Docita login is required.</p>
  </article>

  <a
    href="https://docita.work"
    target="_blank"
    rel="noopener noreferrer"
    class="pdd-powered"
  >
    <span>Powered by</span>
    <DocitaLogo showText={false} className="h-4 w-4" iconClassName="h-4 w-4" />
    <span class="pdd-powered-name">Docita</span>
  </a>
</main>

<style>
  .pdd-main {
    margin-inline: auto;
    display: flex;
    min-height: 60vh;
    width: 100%;
    max-width: 28rem;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: 4rem 1.25rem;
  }

  /*
   * The slip is the artifact: a warm paper surface with a hairline edge and a
   * thin accent band on top. Everything else on the page stays quiet so the
   * slip reads as "the document you came for".
   */
  .pdd-slip {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid color-mix(in oklch, var(--border) 85%, transparent);
    background: linear-gradient(
      168deg,
      color-mix(in oklch, var(--card) 94%, var(--surface-warm) 6%) 0%,
      color-mix(in oklch, var(--surface-warm) 42%, var(--card)) 100%
    );
    box-shadow:
      0 1px 0 color-mix(in oklch, oklch(1 0 0) 45%, transparent) inset,
      0 18px 44px color-mix(in oklch, var(--foreground) 6%, transparent);
    padding: 2rem 1.5rem 1.5rem;
  }

  .dark .pdd-slip {
    background: linear-gradient(
      168deg,
      color-mix(in oklch, var(--card) 92%, var(--surface-warm) 8%) 0%,
      var(--card) 100%
    );
    box-shadow:
      0 1px 0 color-mix(in oklch, oklch(1 0 0) 6%, transparent) inset,
      0 20px 52px rgba(0, 0, 0, 0.3);
  }

  .pdd-slip-band {
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 1.25rem;
    height: 3px;
    border-radius: 0 0 999px 999px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--primary) 24%,
      var(--primary) 76%,
      transparent
    );
    opacity: 0.85;
  }

  .pdd-slip.is-info .pdd-slip-band {
    background: linear-gradient(
      90deg,
      transparent,
      var(--info) 24%,
      var(--info) 76%,
      transparent
    );
  }

  .pdd-slip.is-success .pdd-slip-band {
    background: linear-gradient(
      90deg,
      transparent,
      var(--success) 24%,
      var(--success) 76%,
      transparent
    );
  }

  .pdd-slip-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pdd-record-line {
    font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--muted-foreground) 92%, var(--foreground) 8%);
  }

  .pdd-title {
    font-family: var(--font-display), Georgia, "Times New Roman", serif;
    font-size: clamp(1.6rem, 1rem + 2.4vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    font-weight: 600;
    text-wrap: balance;
    color: var(--foreground);
  }

  .pdd-description {
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  /* Perforation seam between the copy and the tear-off tab. */
  .pdd-slip-body {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-block: 1.5rem 1.25rem;
  }

  .pdd-slip-rule {
    flex: 1;
    height: 1px;
    background-image: repeating-linear-gradient(
      90deg,
      color-mix(in oklch, var(--border) 90%, var(--foreground) 10%) 0 8px,
      transparent 8px 16px
    );
  }

  .pdd-slip-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--surface-warm);
    border: 1px solid color-mix(in oklch, var(--border) 90%, var(--foreground) 10%);
  }

  /*
   * The tear-off tab: the download action lives on the slip itself, separated
   * by a dashed detach line with notch perforations. Downloading reads as
   * tearing the document off the slip.
   */
  .pdd-tear-tab {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    border-radius: calc(var(--radius) - 2px);
    border: 1px solid var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
    padding: 0.9rem 1.1rem;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px color-mix(in oklch, var(--primary) 55%, transparent);
  }

  .pdd-tear-tab::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0.875rem;
    right: 0.875rem;
    height: 1px;
    background-image: repeating-linear-gradient(
      90deg,
      color-mix(in oklch, var(--primary) 55%, var(--border)) 0 7px,
      transparent 7px 13px
    );
    pointer-events: none;
  }

  .dark .pdd-tear-tab::before {
    background-image: repeating-linear-gradient(
      90deg,
      color-mix(in oklch, oklch(1 0 0) 55%, var(--primary)) 0 7px,
      transparent 7px 13px
    );
  }

  .pdd-tear-tab:focus-visible {
    outline: var(--ring-width) solid var(--ring);
    outline-offset: var(--ring-offset-width);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pdd-tear-tab {
      transition:
        transform 0.16s ease,
        box-shadow 0.16s ease,
        background-color 0.16s ease;
    }

    .pdd-tear-tab:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -12px color-mix(in oklch, var(--primary) 65%, transparent);
    }

    .pdd-tear-tab:active {
      transform: translateY(0);
    }
  }

  .pdd-tear-tab-label {
    font-size: var(--fs-base);
    font-weight: 600;
    line-height: 1.2;
  }

  .pdd-tear-tab-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .pdd-note {
    margin-top: 1rem;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--muted-foreground);
    text-align: center;
  }

  .pdd-powered {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    margin-inline: auto;
    font-size: var(--fs-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    border-top: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    padding-top: 0.75rem;
  }

  .pdd-powered:hover {
    color: var(--foreground);
  }

  .pdd-powered-name {
    font-weight: 600;
  }
</style>
