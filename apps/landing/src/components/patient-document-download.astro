---
interface Props {
  title: string;
  description: string;
  downloadHref: string;
  downloadLabel: string;
}

const { title, description, downloadHref, downloadLabel } = Astro.props;
---

<main class="mx-auto flex min-h-[60vh] max-w-lg flex-col justify-center px-6 py-16">
  <h1 class="text-2xl font-semibold tracking-tight text-foreground">{title}</h1>
  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{description}</p>
  <a
    href={downloadHref}
    class="mt-8 inline-flex w-full items-center justify-center rounded-lg bg-primary px-4 py-3 text-sm font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/90"
    download
  >
    {downloadLabel}
  </a>
  <p class="mt-4 text-xs text-muted-foreground">
  This link is for you only. No Docita login is required.
  </p>
</main>
