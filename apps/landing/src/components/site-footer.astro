---
import { DocitaWordmark } from "@workspace/ui/components/indicators/docita-logo";
import { SUPPORT_EMAIL } from "@workspace/types";
---

<footer class="landing-footer text-foreground/80 px-6 py-10">
  <div class="ui-page-shell grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
    <div class="min-w-0">
      <a href="/" class="inline-flex items-center" aria-label="Docita home">
        <DocitaWordmark className="h-10 w-auto max-w-[11rem]" />
      </a>
      <p class="mt-4 text-sm text-foreground/80">
        From paper files, Excel, and WhatsApp chaos to one reliable
        workflow for Indian clinics and hospitals.
      </p>
    </div>

    <div>
      <h2 class="font-semibold text-foreground">Product</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/#rhythm" class="text-foreground/80 transition-colors hover:text-primary">Clinic day rhythm</a></li>
        <li><a href="/#surface-map" class="text-foreground/80 transition-colors hover:text-primary">All surfaces</a></li>
        <li><a href="/#workflow-compare" class="text-foreground/80 transition-colors hover:text-primary">Compare</a></li>
        <li><a href="/#rollout" class="text-foreground/80 transition-colors hover:text-primary">Rollout playbook</a></li>
        <li><a href="/#pricing" class="text-foreground/80 transition-colors hover:text-primary">Pricing</a></li>
        <li><a href="/#faq" class="text-foreground/80 transition-colors hover:text-primary">FAQ</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-semibold text-foreground">Deep dives</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/clinic-management-software-india" class="text-foreground/80 transition-colors hover:text-primary">Clinic management software India</a></li>
        <li><a href="/opd-management-software" class="text-foreground/80 transition-colors hover:text-primary">OPD software</a></li>
        <li><a href="/digital-prescription-software" class="text-foreground/80 transition-colors hover:text-primary">Digital prescriptions</a></li>
        <li><a href="/clinic-billing-software" class="text-foreground/80 transition-colors hover:text-primary">Clinic billing</a></li>
        <li><a href="/paper-to-cloud" class="text-foreground/80 transition-colors hover:text-primary">Paper to cloud</a></li>
        <li><a href="/whatsapp-workflows" class="text-foreground/80 transition-colors hover:text-primary">WhatsApp workflows</a></li>
        <li><a href="/trust" class="text-foreground/80 transition-colors hover:text-primary">Trust &amp; hosting</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-semibold text-foreground">Support</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/trust" class="text-foreground/80 transition-colors hover:text-primary">Trust & Hosting</a></li>
        <li><a href="/contact" class="text-foreground/80 transition-colors hover:text-primary">Help center</a></li>
        <li><a href="/contact" class="text-foreground/80 transition-colors hover:text-primary">Contact us</a></li>
        <li><a href={`mailto:${SUPPORT_EMAIL}`} class="text-foreground/80 transition-colors hover:text-primary">{SUPPORT_EMAIL}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-semibold text-foreground">Legal</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/privacy" class="text-foreground/80 transition-colors hover:text-primary">Privacy Policy</a></li>
        <li><a href="/terms" class="text-foreground/80 transition-colors hover:text-primary">Terms of Service</a></li>
        <li><a href="/refund-policy" class="text-foreground/80 transition-colors hover:text-primary">Refund Policy</a></li>
        <li><a href="/cookies" class="text-foreground/80 transition-colors hover:text-primary">Cookie Policy</a></li>
      </ul>
    </div>
  </div>

