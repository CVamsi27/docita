---
import { DocitaWordmark } from "@workspace/ui/components/docita-logo";
import ThemeToggle from "@/components/theme-toggle.astro";

import { getAppBaseUrl } from "@/lib/public-api";

const appUrl = getAppBaseUrl();
---

<header class="sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="border-b border-primary/20 bg-primary/10">
    <div class="ui-page-shell flex min-h-10 flex-col items-center justify-center gap-2 px-6 py-2 text-center text-sm text-foreground sm:flex-row sm:justify-between sm:text-left">
      <p>
        <span class="font-semibold">14-day free trial is back.</span>
        Start Essential at ₹0 today, no credit card required.
      </p>
      <a
        href={`${appUrl}/onboarding`}
        class="inline-flex items-center rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Start free trial
      </a>
    </div>
  </div>
  <div class="px-6">
    <div class="ui-page-shell flex h-16 items-center">
      <div class="flex flex-1 items-center">
        <a href="/" class="inline-flex items-center" aria-label="Docita home">
          <DocitaWordmark className="h-10 w-auto max-w-[11rem]" />
        </a>
      </div>

      <nav class="hidden flex-1 items-center justify-center gap-6 text-sm font-medium md:flex">
        <a href="/#features" class="text-muted-foreground transition-colors hover:text-foreground">Features</a>
        <a href="/paper-to-cloud" class="text-muted-foreground transition-colors hover:text-foreground">Migration</a>
        <a href="/#pricing" class="text-muted-foreground transition-colors hover:text-foreground">Pricing</a>
        <a href="/trust" class="text-muted-foreground transition-colors hover:text-foreground">Trust</a>
        <a href="/contact" class="text-muted-foreground transition-colors hover:text-foreground">Contact</a>
      </nav>

      <div class="flex flex-1 items-center justify-end gap-2">
        <ThemeToggle />
        <a
          href={`${appUrl}/login`}
          class="hidden rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground md:inline-flex"
        >
          Log In
        </a>
        <a
          href={`${appUrl}/onboarding`}
          class="cta-ring inline-flex h-10 items-center justify-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Start Trial
        </a>
      </div>
    </div>
  </div>
</header>
