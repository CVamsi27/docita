---
import { HeaderActions } from "@/components/header-actions";
import { DocitaWordmark } from "@workspace/ui/components/indicators/docita-logo";
import ThemeToggle from "@/components/theme-toggle.astro";
import { getAppBaseUrl } from "@/lib/get-app-base-url";
const appUrl = getAppBaseUrl();
---
<header class="editorial-site-header">
  <div class="ui-page-shell editorial-header-inner">
    <a href="/" aria-label="Docita home"><DocitaWordmark className="h-9 w-auto" /></a>
    <nav aria-label="Primary navigation" class="editorial-nav">
      <a href="/product">Product</a>
      <a href="/pricing">Pricing</a>
      <a href="/trust">Trust</a>
    </nav>
    <div class="editorial-header-actions">
      <ThemeToggle />
      <HeaderActions appUrl={appUrl} />
    </div>
  </div>
</header>
