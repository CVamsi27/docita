---
import { DocitaWordmark } from "@workspace/ui/components/indicators/docita-logo";
import ThemeToggle from "@/components/theme-toggle.astro";

import { getAppBaseUrl } from "@/lib/get-app-base-url";

const appUrl = getAppBaseUrl();
---

<header
  class="landing-site-header fixed inset-x-0 top-0 z-[60] border-b-2 border-b-primary/12 bg-background"
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="px-4 sm:px-6">
    <div class="ui-page-shell flex h-16 items-center">
      <div class="flex flex-1 items-center">
        <a href="/" class="inline-flex items-center" aria-label="Docita home">
          <DocitaWordmark className="h-9 w-auto max-w-[8.5rem] sm:h-10 sm:max-w-[11rem]" />
        </a>
      </div>

      <nav class="hidden flex-1 items-center justify-center gap-1 rounded-[var(--radius)] border border-border/70 bg-card p-1 text-xs font-semibold uppercase tracking-normal shadow-sm md:flex">
        <a href="/#surface-map" class="rounded-[var(--radius)] px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Surfaces</a>
        <a href="/#rhythm" class="rounded-[var(--radius)] px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Rhythm</a>
        <a href="/#rollout" class="rounded-[var(--radius)] px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Rollout</a>
        <a href="/#pricing" class="rounded-[var(--radius)] px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Pricing</a>
        <a href="/trust" class="rounded-[var(--radius)] px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Trust</a>
        <a href="/contact" class="rounded-[var(--radius)] px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Contact</a>
      </nav>

      <div class="flex flex-1 items-center justify-end gap-1.5 sm:gap-2">
        <ThemeToggle />
        <a
          href={`${appUrl}/login`}
          class="hidden rounded-[var(--radius)] px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground md:inline-flex"
        >
          Log In
        </a>
        <a
          href={`${appUrl}/onboarding`}
          aria-label="Start clinic setup"
          class="cta-ring inline-flex h-9 items-center justify-center rounded-[var(--radius)] bg-primary px-3 text-xs font-semibold text-primary-foreground shadow-md transition-colors hover:bg-primary/90 sm:h-10 sm:px-4 sm:text-sm"
        >
          <span class="sm:hidden">Setup</span>
          <span class="hidden sm:inline">Start setup</span>
        </a>
      </div>
    </div>

    <nav
      class="ui-page-shell flex gap-1 overflow-x-auto overscroll-x-contain border-t border-border/50 px-4 pb-2 pt-2 [scrollbar-width:thin] md:hidden"
      aria-label="Mobile section links"
    >
      <a href="/#surface-map" class="shrink-0 rounded-[var(--radius)] px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Surfaces</a>
      <a href="/#rhythm" class="shrink-0 rounded-[var(--radius)] px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Rhythm</a>
      <a href="/#rollout" class="shrink-0 rounded-[var(--radius)] px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Rollout</a>
      <a href="/#pricing" class="shrink-0 rounded-[var(--radius)] px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Pricing</a>
      <a href="/trust" class="shrink-0 rounded-[var(--radius)] px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Trust</a>
      <a href="/contact" class="shrink-0 rounded-[var(--radius)] px-2.5 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">Contact</a>
    </nav>
  </div>
</header>
