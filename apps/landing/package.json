{
  "name": "@docita/landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3003",
    "build": "next build --webpack",
    "build:cloudflare": "DOCITA_CLOUDFLARE=1 turbo build --filter=@workspace/ui && DOCITA_CLOUDFLARE=1 opennextjs-cloudflare build && node ../../scripts/ensure-opennext-prefetch-manifest-patch.mjs --app=landing && node ../../scripts/check-worker-size.mjs .open-next/worker.js @docita/landing",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "audit:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.10",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.475.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-playwright": "^2.2.2",
    "baseline-browser-mapping": "^2.9.19",
    "@workspace/eslint-config": "workspace:^",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.71.0"
  }
}
