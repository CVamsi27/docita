{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "module": "esnext",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@workspace/types": [
        "../../packages/types/src/index"
      ],
      "@workspace/types/*": [
        "../../packages/types/src/*"
      ],
      "@workspace/ui": [
        "../../packages/ui/src/index"
      ],
      "@workspace/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@workspace/utils": [
        "../../packages/utils/src/index"
      ],
      "@workspace/utils/*": [
        "../../packages/utils/src/*"
      ],
      "@workspace/hooks": [
        "../../packages/hooks/src/index"
      ],
      "@workspace/hooks/*": [
        "../../packages/hooks/src/*"
      ],
      "@workspace/data-access": [
        "../../packages/data-access/src/index"
      ],
      "@workspace/data-access/*": [
        "../../packages/data-access/src/*"
      ]
    },
    "types": [
      "astro/client",
      "react",
      "react-dom"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "astro.config.mjs",
    ".astro/types.d.ts"
  ]
}
