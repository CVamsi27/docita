{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/lib": ["./shared/lib/index"],
      "@/lib/*": ["./shared/lib/*"],
      "@/hooks": ["./shared/hooks/index"],
      "@/hooks/*": ["./shared/hooks/*"],
      "@/components": ["./shared/components/index"],
      "@/components/*": ["./shared/components/*"],
      "@workspace/data-access": ["../../packages/data-access/dist/index"],
      "@workspace/data-access/*": ["../../packages/data-access/dist/*"],
      "@workspace/hooks": ["../../packages/hooks/dist/index"],
      "@workspace/hooks/*": ["../../packages/hooks/dist/*"],
      "@workspace/types": ["../../packages/types/dist/index"],
      "@workspace/types/*": ["../../packages/types/dist/*"],
      "@workspace/ui": ["../../packages/ui/dist/index"],
      "@workspace/ui/*": ["../../packages/ui/dist/*"],
      "@workspace/utils": ["../../packages/utils/dist/index"],
      "@workspace/utils/*": ["../../packages/utils/dist/*"]
    },
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
