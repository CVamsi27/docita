{
  "name": "@docita/app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "dev:host": "vite --port 3000 --host",
    "prebuild": "pnpm -w run build:web-workspace-deps",
    "build": "vite build",
    "build:cloudflare": "node ../../scripts/deploy/build-cloudflare-frontend.mjs",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy --minify",
    "deploy:cloudflare:staging": "pnpm run build:cloudflare --mode staging && wrangler deploy --minify --env staging",
    "deploy:cloudflare:production": "pnpm run build:cloudflare && wrangler deploy --minify --env production",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e",
    "test:e2e:api": "SKIP_SERVER=true playwright test e2e",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts",
    "audit:accessibility": "env -u NO_COLOR FORCE_COLOR=0 playwright test e2e/accessibility.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.47.0",
    "@tanstack/react-query": "^5.90.10",
    "@workspace/data-access": "workspace:*",
    "@workspace/hooks": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "canvas-confetti": "^1.9.4",
    "hono": "^4.7.7",
    "i18next": "^24.2.3",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.66.1",
    "react-i18next": "^15.6.0",
    "react-router": "^8.3.0",
    "react-signature-canvas": "1.1.0-alpha.2",
    "recharts": "^3.4.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.8",
    "react-phone-number-input": "^3.4.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "@workspace/auth": "workspace:*",
    "axe-playwright": "^2.0.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.90.0"
  }
}
