{
  "name": "@docita/app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/clean-next.mjs --if-production && next dev --webpack --port 3000",
    "dev:webpack": "node ./scripts/clean-next.mjs --if-production && next dev --webpack --port 3000",
    "dev:turbopack": "node ./scripts/clean-next.mjs --if-production && next dev --turbopack --port 3000",
    "prestart": "turbo build --filter=@workspace/hooks --filter=@workspace/utils --filter=@workspace/ui --filter=@workspace/types --filter=@workspace/auth --filter=@workspace/data-access",
    "build": "node ./scripts/clean-next.mjs && next build --webpack",
    "build:cloudflare": "pnpm run build:cloudflare:production",
    "build:cloudflare:base": "DOCITA_CLOUDFLARE=1 turbo build --filter=@workspace/hooks --filter=@workspace/utils --filter=@workspace/ui --filter=@workspace/types --filter=@workspace/auth --filter=@workspace/data-access && node -e \"require('fs').rmSync('.open-next', { recursive: true, force: true })\" && DOCITA_CLOUDFLARE=1 opennextjs-cloudflare build && node ../../scripts/ensure-opennext-prefetch-manifest-patch.mjs --app=app",
    "build:cloudflare:production": "APP_URL=https://app.docita.work API_URL=https://api.docita.work/api/v1 API_PROXY_TARGET=https://api.docita.work NEXT_PUBLIC_API_URL=https://api.docita.work/api/v1 NEXT_PUBLIC_APP_URL=https://app.docita.work NEXT_PUBLIC_SOCKET_URL=https://api.docita.work NEXT_PUBLIC_SENTRY_PROJECT=javascript-nextjs NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_SPNm7w8Ig24OSX pnpm run build:cloudflare:base",
    "build:cloudflare:staging": "APP_URL=https://staging-app.docita.work API_URL=https://staging-api.docita.work/api/v1 API_PROXY_TARGET=https://staging-api.docita.work NEXT_PUBLIC_API_URL=https://staging-api.docita.work/api/v1 NEXT_PUBLIC_APP_URL=https://staging-app.docita.work NEXT_PUBLIC_SOCKET_URL=https://staging-api.docita.work NEXT_PUBLIC_SENTRY_PROJECT=javascript-nextjs-staging NEXT_PUBLIC_RAZORPAY_KEY_ID= pnpm run build:cloudflare:base",
    "build:analyze": "node ./scripts/clean-next.mjs && turbo build --filter=@workspace/hooks --filter=@workspace/utils --filter=@workspace/ui --filter=@workspace/types --filter=@workspace/auth --filter=@workspace/data-access && ANALYZE=true next build --webpack",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test e2e",
    "test:e2e:api": "SKIP_SERVER=true playwright test e2e",
    "test:e2e:api:smoke": "SKIP_SERVER=true playwright test e2e/health.spec.ts e2e/analytics.spec.ts e2e/prescriptions.spec.ts e2e/invoices.spec.ts e2e/documents.spec.ts e2e/clinics.spec.ts e2e/queue.spec.ts e2e/medical-coding.spec.ts e2e/lab-tests.spec.ts e2e/inventory.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "audit:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts",
    "test:unit": "vitest run",
    "test:visual": "playwright test tests/visual",
    "test:visual:ui": "playwright test tests/visual --ui",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:visual:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.47.0",
    "@tanstack/react-query": "^5.90.10",
    "@workspace/data-access": "workspace:*",
    "@workspace/hooks": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:^",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.66.1",
    "react-phone-number-input": "^3.4.14",
    "react-signature-canvas": "1.1.0-alpha.2",
    "recharts": "^3.4.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.2",
    "@opennextjs/cloudflare": "^1.17.1",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "axe-playwright": "^2.2.2",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.32.0",
    "globals": "^17.0.0",
    "import-in-the-middle": "^2.0.6",
    "jsdom": "^27.4.0",
    "require-in-the-middle": "^8.0.1",
    "typescript": "^5.9.2",
    "vite": "^6.4.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.71.0"
  }
}
