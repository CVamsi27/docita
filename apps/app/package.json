{
  "name": "@docita/app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:analyze": "ANALYZE=true next build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/e2e-runner.js",
    "test:e2e:api": "SKIP_SERVER=true playwright test e2e",
    "test:e2e:api:smoke": "SKIP_SERVER=true playwright test e2e/health.spec.ts e2e/analytics.spec.ts e2e/prescriptions.spec.ts e2e/invoices.spec.ts e2e/documents.spec.ts e2e/clinics.spec.ts e2e/queue.spec.ts e2e/medical-coding.spec.ts e2e/lab-tests.spec.ts e2e/inventory.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "audit:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:critical-flows": "playwright test e2e/critical-flows.spec.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.38.0",
    "@tanstack/react-query": "^5.90.10",
    "@workspace/data-access": "workspace:*",
    "@workspace/hooks": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:^",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.66.1",
    "react-phone-number-input": "^3.4.14",
    "recharts": "^3.4.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@opennextjs/cloudflare": "^1.17.1",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.1.2",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "axe-playwright": "^2.2.2",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.32.0",
    "globals": "^17.0.0",
    "import-in-the-middle": "^2.0.6",
    "jsdom": "^27.4.0",
    "require-in-the-middle": "^8.0.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.71.0"
  }
}