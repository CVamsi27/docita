APP_URL="http://127.0.0.1:3000"
# Server-side upstream for Cloudflare middleware /api/v1 proxy only (not used by the browser).
API_URL="http://127.0.0.1:3001/api/v1"
API_PROXY_TARGET="http://127.0.0.1:3001/api/v1"
# Browser must use the same-origin proxy so httpOnly auth cookies (access + refresh) attach to the app host.
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_PROJECT="javascript-nextjs"
SENTRY_ORG="docita"
NEXT_PUBLIC_ANALYTICS_URL=""
NEXT_PUBLIC_ENABLE_CONSOLE_TOASTS=false
NEXT_PUBLIC_CAPTURE_CONSOLE_INFO=false
NEXT_PUBLIC_CAPTURE_CONSOLE_WARNINGS=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=""
NEXT_PUBLIC_CLINIC_NAME="Docita"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Cloudflare Turnstile (public /book booking). Use test keys in dev; omit to rely on API dev bypass when configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
DOCITA_CLOUDFLARE="0"
ANALYZE=false
# Do not set NODE_ENV=production for local `pnpm dev` — use development defaults.
