{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["vitest/globals"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.test.ts", "**/*.test.tsx"]
}
