{
  "minLines": 5,
  "minTokens": 50,
  "maxLines": 1000,
  "maxSize": "100kb",
  "mode": "strict",
  "reporters": [
    "console",
    "json"
  ],
  "output": "./.jscpd-report",
  "gitignore": true,
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/.turbo/**",
    "**/pnpm-lock.yaml",
    "**/*.generated.*",
    "**/generated/**",
    "**/migrations/**",
    "scripts/checks/**",
    "**/package.json",
    "**/tsconfig*.json",
    "**/content-scripts/**",
    "**/messages/**",
    "**/parsers/test-helpers.*",
    "**/vite.config.ts",
    "**/vitest.config.ts",
    "**/vitest.setup.ts",
    "**/App.tsx",
    "**/portal-pages.tsx",
    "**/partner-pages.tsx",
    "**/lab-portal-pages.tsx",
    "apps/app/src/features/consultation/components/specialty/*.tsx",
    "apps/app/src/features/patient-portal/components/views/*.tsx",
    "apps/app/src/features/referral-partner/components/Partner*View.tsx",
    "apps/app/src/components/loaders/page-skeleton.tsx",
    "**/api/index.ts",
    "**/playwright.config.ts",
    "**/eslint.config.mjs",
    "**/e2e/utils/viewport-presets.ts",
    "apps/app/src/features/setup/components/join-clinic-request-dialog.tsx",
    "apps/app/src/features/settings/components/management/join-request-review-dialogs.tsx",
    "apps/app/src/features/lab-tests/components/dialogs/OrderLabTestDialog.tsx",
    "apps/app/src/features/invoices/components/forms/invoice-form-sections-shared.tsx",
    "apps/app/src/features/lab-tests/components/layout/lab-tests-page-ui.tsx",
    "apps/app/src/features/ipd/components/forms/admission-form.tsx",
    "apps/app/src/features/settings/components/management/team-member-form-fields.tsx",
    "apps/app/src/features/invoices/hooks/use-invoice-create-logic.ts",
    "apps/app/src/features/invoices/hooks/use-invoice-edit-logic.ts",
    "apps/app/src/features/documents/components/DocumentsPageUI.tsx",
    "apps/app/src/features/patients/components/list/PatientsPageUI.tsx",
    "apps/app/src/features/lab-tests/components/dialogs/order-lab-select-field.tsx",
    "apps/app/src/features/insurance-claims/components/PatientClaimsPanel.tsx",
    "apps/app/src/features/appointments/components/sections/AppointmentRequestsPanel.tsx",
    "apps/app/src/features/consultation/components/modals/billing-modal-summary-panel.tsx",
    "apps/app/src/features/patients/components/details/history/AllergyEditDialog.tsx",
    "apps/app/src/features/consultation/components/consultation-dashboard-nurse-prep.tsx",
    "apps/app/src/features/consultation/components/consultation-dashboard-sections.tsx",
    "**/main.tsx"
  ],
  "format": [
    "typescript",
    "tsx",
    "javascript",
    "jsx",
    "css",
    "json"
  ]
}